
@page
@model ExternalLoginModel

@{
    ViewData["Title"] = "External Login";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card bg-dark text-light border-secondary">

                <div class="card-body p-4">

                    <h1 class="mb-3">
                        Complete Sign In
                    </h1>

                    <p class="text-light">
                        You successfully authenticated with
                        <strong>@Model.ProviderDisplayName</strong>.
                    </p>

                    <p class="text-warning">
                        This provider did not return an email address.
                        For account security, PonyUp will not attach an
                        external login to an email address entered after sign-in.
                    </p>

                    <p class="text-secondary">
                        Return to sign in and use email/password, or use an
                        external account that shares an email address with PonyUp.
                    </p>

                    <a asp-page="./Login"
                       class="btn btn-primary w-100">
                        Back to Sign In
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
