@page
@model IndexModel
@{
    ViewData["Title"] = "My Account";
}

<section class="page-section account-page ponyup-account-dashboard">
    <div class="pricing-page-head">
        <p class="pricing-eyebrow">PONYUP PERFORMANCE</p>
        <h1 class="section-title">MY ACCOUNT</h1>
        <p class="section-subtitle">
            Your account, plan, analysis access, and Garage.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="garage-message">
            @Model.StatusMessage
        </div>
    }

    <div class="ponyup-account-grid">
        <article class="price-card ponyup-account-card">
            <span class="pricing-plan-kicker">ACCOUNT</span>
            <h2>@Model.Email</h2>

            <dl class="garage-detail-list">
                <div>
                    <dt>Plan</dt>
                    <dd>@Model.CurrentPlan</dd>
                </div>

                <div>
                    <dt>Analysis Access</dt>
                    <dd>@Model.AnalysisAccessLabel</dd>
                </div>

                <div>
                    <dt>Free Analysis Used</dt>
                    <dd>@(Model.HasUsedFreeAnalysis ? "YES" : "NO")</dd>
                </div>
            </dl>

            <div class="ponyup-account-actions">
                <a class="btn-red"
                   asp-page="/MyGarage">
                    OPEN MY GARAGE
                </a>

                <a class="btn-dark"
                   asp-page="/Pricing">
                    VIEW PRICING
                </a>
            </div>
        </article>

        <article class="price-card ponyup-account-card">
            <span class="pricing-plan-kicker">PROFILE</span>
            <h2>CONTACT</h2>

            <form method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger"
                     role="alert"></div>

                <div class="garage-field">
                    <label asp-for="Input.PhoneNumber">
                        Phone number
                    </label>

                    <input asp-for="Input.PhoneNumber"
                           autocomplete="tel"
                           placeholder="Optional" />

                    <span asp-validation-for="Input.PhoneNumber"
                          class="garage-validation"></span>
                </div>

                <button type="submit"
                        class="btn-dark ponyup-account-save">
                    SAVE PROFILE
                </button>
            </form>
        </article>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
