@page
@model PonyUpPerformance.Web.Pages.BuyAnalyzerModel

@{
    ViewData["Title"] = "Buy Analyzer";

    int score = Model.Result?.Score ?? 0;

    string recommendation =
        Model.Result?.Recommendation
        ?? "READY";

    string reasoning =
        Model.Result?.Reasoning
        ?? "Enter the vehicle and purchase details, then run the analysis.";

    var stoplight =
        new PonyUpPerformance.Web.Models.PonyUpStoplightResultViewModel
        {
            HasResult = Model.Result != null,
            AnalysisType = "BUY DECISION",
            Recommendation = recommendation,
            ConfidenceScore = score,
            Reasoning = reasoning
        };
}

<section class="page-section analyzer-page buy-bg">
    <h1 class="section-title">BUY ANALYZER</h1>

    <p class="section-subtitle">
        Know before you buy. Evaluate the price, condition, history, risk,
        and expected ownership value.
    </p>

    <div class="price-card analyzer-card"
         style="max-width:900px;margin:0 auto;">

        <form method="post" class="analyzer-form">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <h2>VEHICLE INFORMATION</h2>

            <div class="form-row">
                <label asp-for="Input.Vin">VIN</label>

                <input asp-for="Input.Vin"
                       maxlength="17"
                       autocomplete="off"
                       style="text-transform:uppercase;" />

                <span asp-validation-for="Input.Vin"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.Year">Year</label>
                <input asp-for="Input.Year" />

                <span asp-validation-for="Input.Year"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.Make">Make</label>
                <input asp-for="Input.Make" />

                <span asp-validation-for="Input.Make"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.Model">Model</label>
                <input asp-for="Input.Model" />

                <span asp-validation-for="Input.Model"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.Trim">Trim</label>
                <input asp-for="Input.Trim" />

                <span asp-validation-for="Input.Trim"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.Engine">Engine</label>
                <input asp-for="Input.Engine" />

                <span asp-validation-for="Input.Engine"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.Transmission">
                    Transmission
                </label>

                <input asp-for="Input.Transmission" />

                <span asp-validation-for="Input.Transmission"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.Drivetrain">
                    Drivetrain
                </label>

                <input asp-for="Input.Drivetrain" />

                <span asp-validation-for="Input.Drivetrain"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.BodyStyle">
                    Body Style
                </label>

                <input asp-for="Input.BodyStyle" />

                <span asp-validation-for="Input.BodyStyle"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.FuelType">
                    Fuel Type
                </label>

                <input asp-for="Input.FuelType" />

                <span asp-validation-for="Input.FuelType"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.Mileage">Mileage</label>
                <input asp-for="Input.Mileage" />

                <span asp-validation-for="Input.Mileage"
                      class="text-danger">
                </span>
            </div>

            <div class="analyzer-section-divider"></div>

            <h2>PURCHASE INFORMATION</h2>

            <div class="form-row">
                <label asp-for="Input.AskingPrice">
                    Asking Price
                </label>

                <input asp-for="Input.AskingPrice" />

                <span asp-validation-for="Input.AskingPrice"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.MarketValue">
                    Estimated Market Value
                </label>

                <input asp-for="Input.MarketValue" />

                <span asp-validation-for="Input.MarketValue"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.EstimatedRepairCost">
                    Estimated Repair Cost
                </label>

                <input asp-for="Input.EstimatedRepairCost" />

                <span asp-validation-for="Input.EstimatedRepairCost"
                      class="text-danger">
                </span>
            </div>

            <div class="analyzer-section-divider"></div>

            <h2>DECISION FACTORS</h2>

            <div class="form-row">
                <label asp-for="Input.MechanicalCondition">
                    Mechanical Condition
                </label>

                <select asp-for="Input.MechanicalCondition">
                    <option value="-1">Select Condition</option>
                    <option value="0">Excellent</option>
                    <option value="1">Good</option>
                    <option value="2">Fair</option>
                    <option value="3">Poor</option>
                    <option value="4">Severe</option>
                </select>

                <span asp-validation-for="Input.MechanicalCondition"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.TitleStatus">
                    Title Status
                </label>

                <select asp-for="Input.TitleStatus">
                    <option value="-1">Select Title Status</option>
                    <option value="0">Clean</option>
                    <option value="1">Rebuilt</option>
                    <option value="2">Salvage</option>
                    <option value="3">Flood</option>
                </select>

                <span asp-validation-for="Input.TitleStatus"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.AccidentHistory">
                    Accident History
                </label>

                <select asp-for="Input.AccidentHistory">
                    <option value="-1">Select Accident History</option>
                    <option value="0">None</option>
                    <option value="1">Minor</option>
                    <option value="2">Moderate</option>
                    <option value="3">Major</option>
                </select>

                <span asp-validation-for="Input.AccidentHistory"
                      class="text-danger">
                </span>
            </div>

            <div class="form-row">
                <label asp-for="Input.IntendedUse">
                    Intended Use
                </label>

                <select asp-for="Input.IntendedUse">
                    <option value="-1">Select Intended Use</option>
                    <option value="0">Daily Driver</option>
                    <option value="1">Work Vehicle</option>
                    <option value="2">Family Vehicle</option>
                    <option value="3">Project Vehicle</option>
                    <option value="4">Performance Build</option>
                </select>

                <span asp-validation-for="Input.IntendedUse"
                      class="text-danger">
                </span>
            </div>

            <div class="form-actions">
                <button class="btn-red"
                        type="submit">
                    ANALYZE PURCHASE
                </button>
            </div>
        </form>
    </div>

    @if (Model.Result != null)
    {
        <div class="price-card featured"
             style="max-width:900px;margin:24px auto 0;">

            <h2>BUY ANALYSIS</h2>

            <p>
                <strong>Decision Score:</strong>
                @Model.Result.Score / 100
            </p>

            <p>
                <strong>Confidence Score:</strong>
                @Model.Result.ConfidenceScore / 100
            </p>

            <p>
                <strong>Recommendation:</strong>
                @Model.Result.Recommendation
            </p>

            <p>
                <strong>Risk Level:</strong>
                @Model.Result.RiskLevel
            </p>

            <div class="analyzer-section-divider"></div>

            <h3>PURCHASE NUMBERS</h3>

            <p>
                <strong>Asking Price:</strong>
                @Model.Input.AskingPrice.ToString("C")
            </p>

            <p>
                <strong>Estimated Repair Cost:</strong>
                @Model.Input.EstimatedRepairCost.ToString("C")
            </p>

            <p>
                <strong>Estimated Market Value:</strong>
                @Model.Input.MarketValue.ToString("C")
            </p>

            <p>
                <strong>Maximum Recommended Price:</strong>
                @Model.Result.MaximumRecommendedPrice.ToString("C")
            </p>

            <p>
                <strong>Fair Purchase Price:</strong>
                @Model.Result.FairPurchasePrice.ToString("C")
            </p>

            <p>
                <strong>Suggested First Offer:</strong>
                @Model.Result.SuggestedFirstOffer.ToString("C")
            </p>

            <div class="analyzer-section-divider"></div>

            <h3>WHY WE RECOMMEND THIS</h3>

            <p>@Model.Result.Reasoning</p>

            @if (Model.Result.NextSteps != null &&
     Model.Result.NextSteps.Count > 0)
            {
                <h3>NEXT STEPS</h3>

                <ul>
                    @foreach (string nextStep in Model.Result.NextSteps)
                    {
                        <li>@nextStep</li>
                    }
                </ul>
            }
        </div>
    }

    <partial name="_PonyUpStoplightResult"
             model="stoplight" />
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
