
@page
@model PonyUpPerformance.Web.Pages.BuyAnalyzerModel

@{
    ViewData["Title"] = "Buy Analyzer";

    string recommendation =
        Model.Result?.Recommendation
        ?? "READY";

    string reasoning =
        Model.Result?.Reasoning
        ?? "Enter the vehicle and purchase details, then run the analysis.";

    string inputPanelStyle =
        Model.Result != null
            ? "max-width:900px;margin:0 auto;display:none;"
            : "max-width:900px;margin:0 auto;";

    string FormatMatrixPrice(decimal? value)
    {
        if (!value.HasValue)
        {
            return "Not available — add market value";
        }

        if (value.Value <= 0m)
        {
            return "No positive price supported";
        }

        return value.Value.ToString("C");
    }

    string FormatNegotiationMargin(decimal? value)
    {
        return value.HasValue
            ? $"{value.Value:0.#}%"
            : "Not available — add market value";
    }

    var stoplight =
        new PonyUpPerformance.Web.Models.PonyUpStoplightResultViewModel
        {
            HasResult = Model.Result != null,
            AnalysisType = "BUY DECISION",
            Score = Model.Result?.Score,
            Recommendation = recommendation,
            ConfidenceScore = Model.Result?.ConfidenceScore ?? 0,
            RiskLevel = Model.Result?.RiskLevel ?? string.Empty,
            Reasoning = reasoning
        };
}

<section class="page-section analyzer-page buy-bg">

    <img class="analyzer-banner"
     src="/images/BuyAnal.png"
     alt="PonyUp Performance Buy Analyzer" />

    <div id="buy-input-panel"
         class="price-card analyzer-card"
         style="@inputPanelStyle">

        <form method="post"
              class="analyzer-form">

            <input asp-for="Input.BaseMsrp"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <h2>
                VEHICLE INFORMATION
            </h2>

            <div class="form-row">

                <label asp-for="Input.Vin">
                    VIN
                </label>

                <input asp-for="Input.Vin"
                       maxlength="17"
                       autocomplete="off"
                       data-vin-history="true"
                       style="text-transform:uppercase;" />

                <span asp-validation-for="Input.Vin"
                      class="text-danger">
                </span>

            </div>

            <div class="form-actions"
                 style="margin-top:10px;margin-bottom:20px;">

                <button class="btn-red"
                        type="submit"
                        asp-page-handler="DecodeVin"
                        formnovalidate>

                    DECODE VIN

                </button>

            </div>

            @if (!string.IsNullOrWhiteSpace(
                Model.VinDecodeMessage))
            {
                <p style="font-weight:700;">
                    @Model.VinDecodeMessage
                </p>

                @if (!string.IsNullOrWhiteSpace(
                    Model.Input.Vin))
                {
                    <span hidden
                          data-vin-history-record
                          data-vin="@Model.Input.Vin"
                          data-year="@(Model.Input.Year?.ToString() ?? string.Empty)"
                          data-make="@Model.Input.Make"
                          data-model="@Model.Input.Model">
                    </span>
                }
            }

            <div class="form-row">

                <label asp-for="Input.Year">
                    Year
                </label>

                <input asp-for="Input.Year" />

                <span asp-validation-for="Input.Year"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.Make">
                    Make
                </label>

                <input asp-for="Input.Make" />

                <span asp-validation-for="Input.Make"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.Model">
                    Model
                </label>

                <input asp-for="Input.Model" />

                <span asp-validation-for="Input.Model"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.Trim">
                    Trim
                </label>

                <input asp-for="Input.Trim" />

                <span asp-validation-for="Input.Trim"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.Engine">
                    Engine
                </label>

                <input asp-for="Input.Engine" />

                <span asp-validation-for="Input.Engine"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.Transmission">
                    Transmission
                </label>

                <input asp-for="Input.Transmission" />

                <span asp-validation-for="Input.Transmission"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.Drivetrain">
                    Drivetrain
                </label>

                <input asp-for="Input.Drivetrain" />

                <span asp-validation-for="Input.Drivetrain"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.BodyStyle">
                    Body Style
                </label>

                <input asp-for="Input.BodyStyle" />

                <span asp-validation-for="Input.BodyStyle"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.FuelType">
                    Fuel Type
                </label>

                <input asp-for="Input.FuelType" />

                <span asp-validation-for="Input.FuelType"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.Mileage">
                    Mileage
                </label>

                <input asp-for="Input.Mileage" />

                <span asp-validation-for="Input.Mileage"
                      class="text-danger">
                </span>

            </div>

            <div class="analyzer-section-divider">
            </div>

            <h2>
                PURCHASE INFORMATION
            </h2>

            <div class="form-row">

                <label asp-for="Input.AskingPrice">
                    Asking Price
                </label>

                <input asp-for="Input.AskingPrice" />

                <span asp-validation-for="Input.AskingPrice"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.MarketValue">
                    Estimated Market Value
                </label>

                <input asp-for="Input.MarketValue" />

                <span asp-validation-for="Input.MarketValue"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.EstimatedRepairCost">
                    Estimated Repair Cost
                </label>

                <input asp-for="Input.EstimatedRepairCost" />

                <span asp-validation-for="Input.EstimatedRepairCost"
                      class="text-danger">
                </span>

            </div>

            <div class="analyzer-section-divider">
            </div>

            <h2>
                DECISION FACTORS
            </h2>

            <div class="form-row">

                <label asp-for="Input.MechanicalCondition">
                    Mechanical Condition
                </label>

                <select asp-for="Input.MechanicalCondition">

                    <option value="-1">
                        Select Condition
                    </option>

                    <option value="0">
                        Excellent
                    </option>

                    <option value="1">
                        Good
                    </option>

                    <option value="2">
                        Fair
                    </option>

                    <option value="3">
                        Poor
                    </option>

                    <option value="4">
                        Severe
                    </option>

                </select>

                <span asp-validation-for="Input.MechanicalCondition"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.TitleStatus">
                    Title Status
                </label>

                <select asp-for="Input.TitleStatus">

                    <option value="-1">
                        Select Title Status
                    </option>

                    <option value="0">
                        Clean
                    </option>

                    <option value="1">
                        Rebuilt
                    </option>

                    <option value="2">
                        Salvage
                    </option>

                    <option value="3">
                        Flood
                    </option>

                </select>

                <span asp-validation-for="Input.TitleStatus"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.AccidentHistory">
                    Accident History
                </label>

                <select asp-for="Input.AccidentHistory">

                    <option value="-1">
                        Select Accident History
                    </option>

                    <option value="0">
                        None
                    </option>

                    <option value="1">
                        Minor
                    </option>

                    <option value="2">
                        Moderate
                    </option>

                    <option value="3">
                        Major
                    </option>

                </select>

                <span asp-validation-for="Input.AccidentHistory"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.IntendedUse">
                    Intended Use
                </label>

                <select asp-for="Input.IntendedUse">

                    <option value="-1">
                        Select Intended Use
                    </option>

                    <option value="0">
                        Daily Driver
                    </option>

                    <option value="1">
                        Work Vehicle
                    </option>

                    <option value="2">
                        Family Vehicle
                    </option>

                    <option value="3">
                        Project Vehicle
                    </option>

                    <option value="4">
                        Performance Build
                    </option>

                </select>

                <span asp-validation-for="Input.IntendedUse"
                      class="text-danger">
                </span>

            </div>

            <div class="form-actions">

                <button class="btn-red"
                        type="submit"
                        asp-page-handler="Analyze">

                    ANALYZE PURCHASE

                </button>

            </div>

        </form>

    </div>

    @if (Model.Result != null)
    {
        <div id="buy-result-panel">

            <partial name="_PonyUpStoplightResult"
                     model="stoplight" />

            <div class="form-actions"
                 style="max-width:900px;margin:20px auto;">

                <button type="button"
                        class="btn-dark"
                        onclick="editBuyAnalysis()">

                    EDIT ANALYSIS

                </button>

            </div>

            <div class="price-card featured"
                 style="max-width:900px;margin:0 auto;">

                <h2>
                    PURCHASE NUMBERS
                </h2>

                <p>
                    <strong>Seller Asking Price:</strong>

                    @(Model.Input.AskingPrice.HasValue
                        ? Model.Input.AskingPrice.Value.ToString("C")
                        : "Not provided")
                </p>

                <p>
                    <strong>Estimated Market Value:</strong>

                    @(Model.Input.MarketValue.HasValue
                        ? Model.Input.MarketValue.Value.ToString("C")
                        : "Not provided")
                </p>

                <p>
                    <strong>Estimated Repair Cost:</strong>

                    @(Model.Input.EstimatedRepairCost.HasValue
                        ? Model.Input.EstimatedRepairCost.Value.ToString("C")
                        : "Not provided")
                </p>

                <div class="analyzer-section-divider">
                </div>

                <h3>
                    PONYUP PRICING MATRIX
                </h3>

                <p>
                    <strong>PonyUp Fair Asking Price:</strong>

                    @FormatMatrixPrice(
                        Model.Result.FairAskingPrice)
                </p>

                <p>
                    <strong>Buyer Negotiation Margin:</strong>

                    @FormatNegotiationMargin(
                        Model.Result.BuyerNegotiationMarginPercent)
                </p>

                <p>
                    <strong>Maximum Recommended Price:</strong>

                    @FormatMatrixPrice(
                        Model.Result.MaximumRecommendedPrice)
                </p>

                <p>
                    <strong>Fair Purchase Price:</strong>

                    @FormatMatrixPrice(
                        Model.Result.FairPurchasePrice)
                </p>

                <p>
                    <strong>Suggested First Offer:</strong>

                    @FormatMatrixPrice(
                        Model.Result.SuggestedFirstOffer)
                </p>

                @if (!string.IsNullOrWhiteSpace(
                    Model.Result.FinancialImpact))
                {
                    <div class="analyzer-section-divider">
                    </div>

                    <h3>
                        FINANCIAL IMPACT
                    </h3>

                    <p>
                        @Model.Result.FinancialImpact
                    </p>
                }

                @if (Model.Result.NextSteps != null &&
                     Model.Result.NextSteps.Count > 0)
                {
                    <div class="analyzer-section-divider">
                    </div>

                    <h3>
                        NEXT STEPS
                    </h3>

                    <ul>

                        @foreach (
                            string nextStep
                            in Model.Result.NextSteps)
                        {
                            <li>
                                @nextStep
                            </li>
                        }

                    </ul>
                }

            </div>

        </div>
    }

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        function editBuyAnalysis() {

            const inputPanel =
                document.getElementById(
                    "buy-input-panel");

            const resultPanel =
                document.getElementById(
                    "buy-result-panel");

            if (resultPanel) {

                resultPanel.style.display =
                    "none";
            }

            if (inputPanel) {

                inputPanel.style.display =
                    "block";

                inputPanel.scrollIntoView({

                    behavior:
                        "smooth",

                    block:
                        "start"
                });
            }
        }

    </script>
}
