@page
@model PonyUpPerformance.Web.Pages.SellAnalyzerModel

@{
    ViewData["Title"] = "Sell Analyzer";

    string recommendation =
        Model.Result?.Recommendation
        ?? "READY";

    string reasoning =
        Model.Result?.Reasoning
        ?? "Enter the vehicle and selling details, then run the analysis.";

    string inputPanelStyle =
        Model.Result != null
            ? "max-width:900px;margin:0 auto;display:none;"
            : "max-width:900px;margin:0 auto;";

    string Money(decimal? value)
    {
        return value.HasValue
            ? value.Value.ToString("C0")
            : "Not provided";
    }

    string PriceDifference(decimal? value)
    {
        if (!value.HasValue)
        {
            return "Not available";
        }

        if (value.Value > 0)
        {
            return $"{value.Value:C0} above market";
        }

        if (value.Value < 0)
        {
            return $"{Math.Abs(value.Value):C0} below market";
        }

        return "At market value";
    }

    var stoplight =
        new PonyUpPerformance.Web.Models.PonyUpStoplightResultViewModel
        {
            HasResult = Model.Result != null,
            AnalysisType = "SELL DECISION",
            Score = Model.Result?.Score,
            Recommendation = recommendation,
            ConfidenceScore = Model.Result?.ConfidenceScore ?? 0,
            RiskLevel = Model.Result?.RiskLevel ?? string.Empty,
            Reasoning = reasoning
        };
}

<section class="page-section analyzer-page sell-bg">

    <img class="analyzer-banner"
         src="/images/SellAnal.png"
         alt="PonyUp Performance Sell Analyzer" />

    <div id="sell-input-panel"
         class="price-card analyzer-card"
         style="@inputPanelStyle">

        <form method="post"
              class="analyzer-form">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <h2>
                VEHICLE INFORMATION
            </h2>

            <div class="form-row">

                <label asp-for="Input.Vin">
                    VIN
                </label>

                <input asp-for="Input.Vin"
                       maxlength="17"
                       autocomplete="off"
                       data-vin-history="true"
                       style="text-transform:uppercase;" />

                <span asp-validation-for="Input.Vin"
                      class="text-danger">
                </span>

            </div>

            <div class="form-actions"
                 style="margin-top:10px;margin-bottom:20px;">

                <button class="btn-red"
                        type="submit"
                        asp-page-handler="DecodeVin"
                        formnovalidate>

                    DECODE VIN

                </button>

            </div>

            @if (!string.IsNullOrWhiteSpace(
                Model.VinDecodeMessage))
            {
                <p style="font-weight:700;">
                    @Model.VinDecodeMessage
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(
                Model.MarketValueMessage))
            {
                <p style="font-weight:700;">
                    @Model.MarketValueMessage
                </p>
            }

            <div class="form-row">

                <label asp-for="Input.Year">
                    Year
                </label>

                <input asp-for="Input.Year" />

                <span asp-validation-for="Input.Year"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.Make">
                    Make
                </label>

                <input asp-for="Input.Make" />

            </div>

            <div class="form-row">

                <label asp-for="Input.Model">
                    Model
                </label>

                <input asp-for="Input.Model" />

            </div>

            <div class="form-row">

                <label asp-for="Input.Trim">
                    Trim
                </label>

                <input asp-for="Input.Trim" />

            </div>

            <div class="form-row">

                <label asp-for="Input.Mileage">
                    Mileage
                </label>

                <input asp-for="Input.Mileage" />

                <span asp-validation-for="Input.Mileage"
                      class="text-danger">
                </span>

            </div>

            <div class="analyzer-section-divider">
            </div>

            <h2>
                SELLING NUMBERS
            </h2>

            <div class="form-row">

                <label asp-for="Input.ExpectedSalePrice">
                    Asking / Expected Sale Price
                </label>

                <input asp-for="Input.ExpectedSalePrice" />

                <span asp-validation-for="Input.ExpectedSalePrice"
                      class="text-danger">
                </span>

            </div>

            <div class="form-row">

                <label asp-for="Input.MarketValue">
                    Estimated Market Value
                </label>

                <input asp-for="Input.MarketValue" />

                <span asp-validation-for="Input.MarketValue"
                      class="text-danger">
                </span>

            </div>

            <div class="analyzer-section-divider">
            </div>

            <h2>
                DECISION FACTORS
            </h2>

            <div class="form-row">

                <label asp-for="Input.Condition">
                    Overall Vehicle Condition
                </label>

                <select asp-for="Input.Condition">

                    <option value="-1">
                        Select Condition
                    </option>

                    <option value="0">
                        Excellent
                    </option>

                    <option value="1">
                        Good
                    </option>

                    <option value="2">
                        Fair
                    </option>

                    <option value="3">
                        Poor
                    </option>

                    <option value="4">
                        Severe
                    </option>

                </select>

            </div>

            <div class="form-row">

                <label asp-for="Input.TitleStatus">
                    Title Status
                </label>

                <select asp-for="Input.TitleStatus">

                    <option value="-1">
                        Select Title Status
                    </option>

                    <option value="0">
                        Clean
                    </option>

                    <option value="1">
                        Rebuilt
                    </option>

                    <option value="2">
                        Salvage
                    </option>

                    <option value="3">
                        Flood
                    </option>

                </select>

            </div>

            <div class="form-row">

                <label asp-for="Input.AccidentHistory">
                    Accident History
                </label>

                <select asp-for="Input.AccidentHistory">

                    <option value="-1">
                        Select Accident History
                    </option>

                    <option value="0">
                        None
                    </option>

                    <option value="1">
                        Minor
                    </option>

                    <option value="2">
                        Moderate
                    </option>

                    <option value="3">
                        Major
                    </option>

                </select>

            </div>

            <div class="form-row">

                <label asp-for="Input.Runs">
                    Runs
                </label>

                <select asp-for="Input.Runs">

                    <option value="">
                        Not Provided
                    </option>

                    <option value="true">
                        Yes
                    </option>

                    <option value="false">
                        No
                    </option>

                </select>

            </div>

            <div class="form-row">

                <label asp-for="Input.Drives">
                    Drives
                </label>

                <select asp-for="Input.Drives">

                    <option value="">
                        Not Provided
                    </option>

                    <option value="true">
                        Yes
                    </option>

                    <option value="false">
                        No
                    </option>

                </select>

            </div>

            <div class="form-row">

                <label asp-for="Input.IntendedUse">
                    Intended Use
                </label>

                <select asp-for="Input.IntendedUse">

                    <option value="-1">
                        Select Intended Use
                    </option>

                    <option value="0">
                        Daily Driver
                    </option>

                    <option value="1">
                        Work Vehicle
                    </option>

                    <option value="2">
                        Family Vehicle
                    </option>

                    <option value="3">
                        Project Vehicle
                    </option>

                    <option value="4">
                        Performance Build
                    </option>

                    <option value="5">
                        Restoration
                    </option>

                </select>

            </div>

            <div class="form-actions">

                <button class="btn-red"
                        type="submit"
                        asp-page-handler="Analyze">

                    ANALYZE SALE

                </button>

            </div>

        </form>

    </div>

    @if (Model.Result != null)
    {
        <div id="sell-result-panel">

            <partial name="_PonyUpStoplightResult"
                     model="stoplight" />

            <div class="form-actions"
                 style="max-width:900px;margin:20px auto;">

                <button type="button"
                        class="btn-dark"
                        onclick="editSellAnalysis()">

                    EDIT ANALYSIS

                </button>

            </div>

            <div class="price-card featured"
                 style="max-width:900px;margin:0 auto;">

                <h2>
                    SELLING NUMBERS
                </h2>

                <p>
                    <strong>
                        Asking / Expected Sale Price:
                    </strong>

                    @Money(
                        Model.Input.ExpectedSalePrice)
                </p>

                <p>
                    <strong>
                        Estimated Market Value:
                    </strong>

                    @Money(
                        Model.Input.MarketValue)
                </p>

                <p>
                    <strong>
                        Price Position:
                    </strong>

                    @PriceDifference(
                        Model.Result.SalePriceVsMarketDifference)
                </p>

                <p>
                    <strong>
                        Sale Price vs Market:
                    </strong>

                    @(Model.Result.SalePriceVsMarketPercent.HasValue
                        ? $"{Model.Result.SalePriceVsMarketPercent.Value:0.#}%"
                        : "Not available")
                </p>

                <div class="analyzer-section-divider">
                </div>

                <h3>
                    PONYUP SELL PROFILE
                </h3>

                <p>
                    <strong>
                        Weighting Profile:
                    </strong>

                    @Model.Result.WeightingProfile
                </p>

                @if (!string.IsNullOrWhiteSpace(
                    Model.Result.FinancialImpact))
                {
                    <div class="analyzer-section-divider">
                    </div>

                    <h3>
                        FINANCIAL IMPACT
                    </h3>

                    <p>
                        @Model.Result.FinancialImpact
                    </p>
                }

                @if (Model.Result.NextSteps.Count > 0)
                {
                    <div class="analyzer-section-divider">
                    </div>

                    <h3>
                        NEXT STEPS
                    </h3>

                    <ul>

                        @foreach (
                            string nextStep
                            in Model.Result.NextSteps)
                        {
                            <li>
                                @nextStep
                            </li>
                        }

                    </ul>
                }

            </div>

        </div>
    }

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        function editSellAnalysis() {

            const inputPanel =
                document.getElementById(
                    "sell-input-panel");

            const resultPanel =
                document.getElementById(
                    "sell-result-panel");

            if (resultPanel) {

                resultPanel.style.display =
                    "none";
            }

            if (inputPanel) {

                inputPanel.style.display =
                    "block";

                inputPanel.scrollIntoView({

                    behavior:
                        "smooth",

                    block:
                        "start"
                });
            }
        }

    </script>
}
