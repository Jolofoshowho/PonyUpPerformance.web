@page
@{
    ViewData["Title"] = "Contact";
}

<section class="page-section">

    <h1 class="section-title">
        CONTACT PONYUP
    </h1>

    <p class="section-subtitle">
        Questions, account help, business inquiries, or feedback.
    </p>

    <div class="price-card featured"
         style="max-width:760px;margin:0 auto;min-height:0;">

        <h2>
            CONTACT &amp; SUPPORT
        </h2>

        <p style="font-size:1.05rem;line-height:1.6;">
            For account support, billing questions, partnerships,
            technical issues, or general inquiries, contact
            PonyUp Performance directly.
        </p>

        <p style="font-size:1.15rem;font-weight:900;margin:24px 0;">
            <a href="mailto:lopezkb258@gmail.com"
               style="color:#ff3131;text-decoration:none;">
                lopezkb258@gmail.com
            </a>
        </p>

        <a class="btn-red"
           href="mailto:lopezkb258@gmail.com">
            EMAIL PONYUP
        </a>

        <div class="analyzer-section-divider"
             style="margin:30px 0;">
        </div>

        <h3>
            ACCOUNT SUPPORT
        </h3>

        <p style="line-height:1.6;">
            Include the email address associated with your
            PonyUp account and a short description of the issue.
        </p>

        <h3 style="margin-top:24px;">
            VEHICLE ANALYSIS QUESTIONS
        </h3>

        <p style="line-height:1.6;margin-bottom:0;">
            Include the vehicle year, make, model, VIN if available,
            and which PonyUp analyzer you were using.
        </p>

    </div>

</section>
