@page
@model PonyUpPerformance.Web.Pages.MyGarageModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    var carImagesApiKey =
        Configuration["CarImages:ApiKey"]
        ?? string.Empty;
    ViewData["Title"] = "My Garage";

    string VehicleName(PonyUpPerformance.Web.Models.GarageVehicle vehicle)
    {
        var parts = new List<string>();

        if (vehicle.Year > 0)
        {
            parts.Add(vehicle.Year.ToString());
        }

        if (!string.IsNullOrWhiteSpace(vehicle.Make))
        {
            parts.Add(vehicle.Make);
        }

        if (!string.IsNullOrWhiteSpace(vehicle.Model))
        {
            parts.Add(vehicle.Model);
        }

        return parts.Count > 0
            ? string.Join(" ", parts)
            : "Saved Vehicle";
    }
}

<section class="garage-page">
    <div class="garage-dashboard">

        <aside class="garage-sidebar">
            <div class="garage-sidebar-header">
                <h2>MY VEHICLES</h2>

                <button type="button"
                        class="garage-add-trigger"
                        data-open-garage-add>
                    <span>+</span>
                    ADD VEHICLE
                </button>
            </div>

            @if (Model.Vehicles.Count == 0)
            {
                <div class="garage-sidebar-empty">
                    <p>No vehicles saved yet.</p>

                    <button type="button"
                            data-open-garage-add>
                        ADD YOUR FIRST VEHICLE
                    </button>
                </div>
            }
            else
            {
                <div class="garage-vehicle-list">
                    @foreach (var vehicle in Model.Vehicles)
                    {
                        var active = Model.SelectedVehicle?.Id == vehicle.Id;

                        <a class="garage-vehicle-row @(active ? "active" : "")"
                           asp-page="/MyGarage"
                           asp-route-vehicleId="@vehicle.Id">

                            <span class="garage-vehicle-thumb"
                                  aria-hidden="true">
                                @if (!string.IsNullOrWhiteSpace(carImagesApiKey) &&
                                     !string.IsNullOrWhiteSpace(vehicle.Make) &&
                                     !string.IsNullOrWhiteSpace(vehicle.Model) &&
                                     vehicle.Year > 0)
                                {
                                    <img class="garage-vehicle-thumb-image"
                                         data-ci-type="car"
                                         data-ci-make="@vehicle.Make"
                                         data-ci-model="@vehicle.Model"
                                         data-ci-year="@vehicle.Year"
                                         data-ci-view="front34"
                                         data-ci-width="256"
                                         alt="" />
                                }
                                else
                                {
                                    <span class="garage-vehicle-thumb-placeholder">
                                        AUTO
                                    </span>
                                }
                            </span>

                            <span class="garage-vehicle-copy">
                                <strong>@VehicleName(vehicle)</strong>
                                <small>
                                    @(vehicle.Mileage > 0
                                        ? $"{vehicle.Mileage:N0} mi"
                                        : "Mileage —")
                                </small>
                            </span>

                            <span class="garage-row-chevron">›</span>
                        </a>
                    }
                </div>
            }

            <a class="garage-history-link"
               href="#garageHistory">
                <span>↻</span>
                VIEW ANALYSIS HISTORY
            </a>

            <div class="garage-profile-mini">
                <div>
                    <span>PLAN</span>
                    <strong>@Model.CurrentPlan</strong>
                </div>

                <div>
                    <span>ANALYSES</span>
                    <strong>@Model.AnalysisAccessLabel</strong>
                </div>
            </div>
        </aside>

        <main class="garage-main">
            <header class="garage-main-header">
                <div>
                    <h1>MY GARAGE</h1>
                    <p>View and manage your vehicles</p>
                </div>

                <div class="garage-main-actions">
                    <button type="button"
                            class="garage-settings-link"
                            data-toggle-garage-settings>
                        ⚙ GARAGE SETTINGS
                    </button>

                    <button type="button"
                            class="garage-main-add"
                            data-open-garage-add>
                        + ADD VEHICLE
                    </button>
                </div>
            </header>

            <section id="garageSettingsPanel"
                     class="garage-settings-panel"
                     hidden>
                <div class="garage-settings-heading">
                    <div>
                        <h2>GARAGE SETTINGS</h2>
                        <p>Your PonyUp account and Garage access.</p>
                    </div>

                    <button type="button"
                            data-close-garage-settings
                            aria-label="Close Garage settings">
                        ×
                    </button>
                </div>

                <div class="garage-settings-grid">
                    <div>
                        <span>ACCOUNT</span>
                        <strong>@Model.UserEmail</strong>
                    </div>

                    <div>
                        <span>PLAN</span>
                        <strong>@Model.CurrentPlan</strong>
                    </div>

                    <div>
                        <span>ANALYSIS ACCESS</span>
                        <strong>@Model.AnalysisAccessLabel</strong>
                    </div>

                    <div>
                        <span>SAVED VEHICLES</span>
                        <strong>@Model.Vehicles.Count</strong>
                    </div>
                </div>

                @if (Model.IsOwnerAccess)
                {
                    <div class="garage-owner-access">
                        OWNER ACCESS ACTIVE · KING CLOUD · UNLIMITED
                    </div>
                }
            </section>

            @if (TempData["GarageMessage"] is string message)
            {
                <div class="garage-message">
                    @message
                </div>
            }

            @if (Model.SelectedVehicle == null)
            {
                <div class="garage-empty-state">
                    <div class="garage-empty-mark">P</div>

                    <h2>YOUR GARAGE IS READY</h2>

                    <p>
                        Add one of your previously decoded VINs or enter a vehicle manually.
                    </p>

                    <button type="button"
                            class="garage-main-add"
                            data-open-garage-add>
                        + ADD VEHICLE
                    </button>
                </div>
            }
            else
            {
                var vehicle = Model.SelectedVehicle;
                var latest = Model.RecentAnalyses.FirstOrDefault();

                <section class="garage-selected-summary">
                    <h2>@VehicleName(vehicle)</h2>

                    <p>
                        <span>@(vehicle.Mileage > 0 ? $"{vehicle.Mileage:N0} mi" : "Mileage —")</span>
                        <i></i>
                        <span>@(string.IsNullOrWhiteSpace(vehicle.BodyStyle) ? "Body —" : vehicle.BodyStyle)</span>
                        <i></i>
                        <span>@(string.IsNullOrWhiteSpace(vehicle.Drivetrain) ? "Drivetrain —" : vehicle.Drivetrain)</span>
                        <i></i>
                        <span>@(string.IsNullOrWhiteSpace(vehicle.FuelType) ? "Fuel —" : vehicle.FuelType)</span>
                    </p>
                </section>

                <section class="garage-showcase">
                    <div class="garage-stage-area">
                        @if (Model.PreviousVehicleId.HasValue)
                        {
                            <a class="garage-stage-arrow garage-stage-prev"
                               asp-page="/MyGarage"
                               asp-route-vehicleId="@Model.PreviousVehicleId"
                               aria-label="Previous vehicle">
                                ‹
                                <small>PREV</small>
                            </a>
                        }

                        <div class="garage-viewer-wrap">
                            @if (!string.IsNullOrWhiteSpace(carImagesApiKey) &&
                                 !string.IsNullOrWhiteSpace(vehicle.Make) &&
                                 !string.IsNullOrWhiteSpace(vehicle.Model) &&
                                 vehicle.Year > 0)
                            {
                                <model-viewer id="garageCatalogViewer"
                                              class="garage-catalog-viewer"
                                              data-ci-type="car"
                                              data-ci-make="@vehicle.Make"
                                              data-ci-model="@vehicle.Model"
                                              data-ci-year="@vehicle.Year"
                                              data-ci-view="front34"
                                              data-ci-speed="12"
                                              data-ci-light="7"
                                              data-ci-backdrop="radial-gradient(120% 120% at 50% 28%, #22272b, #090c0e)"
                                              camera-controls
                                              auto-rotate
                                              shadow-intensity="1"
                                              exposure="1.05"
                                              aria-label="@VehicleName(vehicle) interactive 3D model">
                                </model-viewer>

                                <div id="garageModelQuality"
                                     class="garage-model-quality exact"
                                     aria-live="polite">
                                    CATALOG 3D
                                </div>
                            }
                            else
                            {
                                <div class="garage-model-unavailable">
                                    <div class="garage-model-unavailable-mark">3D</div>
                                    <strong>VEHICLE MODEL READY WHEN IDENTIFIED</strong>
                                    <span>
                                        Add Year, Make, and Model to load the correct vehicle.
                                    </span>
                                </div>
                            }

                            <div class="garage-viewer-hint">
                                Drag to rotate · Scroll to zoom · Auto-spin resumes when released
                            </div>
                        </div>

                        @if (Model.NextVehicleId.HasValue)
                        {
                            <a class="garage-stage-arrow garage-stage-next"
                               asp-page="/MyGarage"
                               asp-route-vehicleId="@Model.NextVehicleId"
                               aria-label="Next vehicle">
                                ›
                                <small>NEXT</small>
                            </a>
                        }
                    </div>

                    <aside class="garage-paint-panel">
                        <div class="garage-paint-heading">
                            <h3>PAINT COLOR</h3>
                            <p>@vehicle.Make Factory Colors</p>
                        </div>

                        <div class="garage-paint-grid">
                            @foreach (var paint in Model.PaintColors)
                            {
                                <form method="post"
                                      asp-page-handler="SelectPaint"
                                      class="garage-paint-form">
                                    <input type="hidden" name="vehicleId" value="@vehicle.Id" />
                                    <input type="hidden" name="paintName" value="@paint.Name" />
                                    <input type="hidden" name="paintCode" value="@paint.Code" />
                                    <input type="hidden" name="paintHex" value="@paint.Hex" />

                                    <button type="submit"
                                            class="garage-paint-chip @(string.Equals(vehicle.SelectedPaintHex, paint.Hex, StringComparison.OrdinalIgnoreCase) ? "selected" : "")"
                                            title="@paint.Name"
                                            aria-label="Select @paint.Name">
                                        <span class="garage-paint-swatch"
                                              style="background:@paint.Hex;"></span>
                                    </button>
                                </form>
                            }
                        </div>

                        <div class="garage-paint-current">
                            <strong>
                                @(string.IsNullOrWhiteSpace(vehicle.SelectedPaintName)
                                    ? "UNSELECTED COLOR"
                                    : vehicle.SelectedPaintName.ToUpperInvariant())
                            </strong>

                            <span>
                                @(string.IsNullOrWhiteSpace(vehicle.SelectedPaintCode)
                                    ? "—"
                                    : vehicle.SelectedPaintCode)
                            </span>
                        </div>
                    </aside>
                </section>

                <nav class="garage-view-tabs"
                     aria-label="Vehicle sections">
                    <a class="active" href="#garageExterior">
                        <span>▣</span>
                        EXTERIOR
                    </a>

                    <a href="#garageDetails">
                        <span>☷</span>
                        DETAILS
                    </a>

                    <a href="#garageAnalysis">
                        <span>▥</span>
                        ANALYSIS
                    </a>

                    <a href="#garageHistory">
                        <span>↻</span>
                        HISTORY
                    </a>
                </nav>

                <section class="garage-info-board"
                         id="garageExterior">

                    <div class="garage-info-column"
                         id="garageDetails">
                        <h3>VEHICLE DETAILS</h3>

                        <dl class="garage-detail-list">
                            <div><dt>Year</dt><dd>@(vehicle.Year > 0 ? vehicle.Year.ToString() : "—")</dd></div>
                            <div><dt>Make</dt><dd>@(string.IsNullOrWhiteSpace(vehicle.Make) ? "—" : vehicle.Make)</dd></div>
                            <div><dt>Model</dt><dd>@(string.IsNullOrWhiteSpace(vehicle.Model) ? "—" : vehicle.Model)</dd></div>
                            <div><dt>Trim</dt><dd>@(string.IsNullOrWhiteSpace(vehicle.Trim) ? "—" : vehicle.Trim)</dd></div>
                            <div><dt>Body Style</dt><dd>@(string.IsNullOrWhiteSpace(vehicle.BodyStyle) ? "—" : vehicle.BodyStyle)</dd></div>
                            <div><dt>Mileage</dt><dd>@(vehicle.Mileage > 0 ? $"{vehicle.Mileage:N0} mi" : "—")</dd></div>
                            <div><dt>Drivetrain</dt><dd>@(string.IsNullOrWhiteSpace(vehicle.Drivetrain) ? "—" : vehicle.Drivetrain)</dd></div>
                            <div><dt>Fuel Type</dt><dd>@(string.IsNullOrWhiteSpace(vehicle.FuelType) ? "—" : vehicle.FuelType)</dd></div>
                            <div><dt>Engine</dt><dd>@(string.IsNullOrWhiteSpace(vehicle.Engine) ? "—" : vehicle.Engine)</dd></div>
                            <div><dt>VIN</dt><dd>@(string.IsNullOrWhiteSpace(vehicle.Vin) ? "—" : vehicle.Vin)</dd></div>
                        </dl>

                        <form method="post"
                              asp-page-handler="UpdateMileage"
                              class="garage-mileage-form">
                            <input type="hidden"
                                   name="vehicleId"
                                   value="@vehicle.Id" />

                            <label for="garageMileage">Update mileage</label>

                            <div>
                                <input id="garageMileage"
                                       name="mileage"
                                       type="number"
                                       min="0"
                                       value="@vehicle.Mileage" />

                                <button type="submit"
                                        class="garage-secondary-button">
                                    SAVE
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="garage-info-column"
                         id="garageAnalysis">
                        <h3>RECENT ANALYSIS</h3>

                        @if (latest == null)
                        {
                            <div class="garage-no-analysis">
                                <p>No saved analysis for this vehicle yet.</p>

                                <a asp-page="/DecisionCenter">
                                    RUN NEW ANALYSIS
                                </a>
                            </div>
                        }
                        else
                        {
                            <dl class="garage-analysis-list">
                                <div><dt>Type</dt><dd>@latest.AnalysisType</dd></div>
                                <div><dt>Date</dt><dd>@latest.CreatedOn.ToLocalTime().ToString("MMM d, yyyy")</dd></div>
                                <div><dt>Recommendation</dt><dd class="garage-recommendation">@latest.Recommendation</dd></div>
                                <div><dt>Confidence Score</dt><dd>@latest.ConfidenceScore%</dd></div>

                                @if (latest.ExpectedEstimate > 0)
                                {
                                    <div>
                                        <dt>Expected Cost</dt>
                                        <dd>@latest.ExpectedEstimate.ToString("C0")</dd>
                                    </div>
                                }
                            </dl>

                            <a class="garage-analysis-button"
                               href="#garageHistory">
                                VIEW ANALYSIS HISTORY
                            </a>
                        }
                    </div>

                    <div class="garage-info-column garage-quick-actions">
                        <h3>VEHICLE QUICK ACTIONS</h3>

                        <a asp-page="/DecisionCenter">
                            <span>⌕</span>
                            RUN NEW ANALYSIS
                        </a>

                        <a href="#garageHistory">
                            <span>▤</span>
                            ANALYSIS HISTORY
                        </a>

                        <button type="button"
                                data-focus-mileage>
                            <span>✎</span>
                            UPDATE MILEAGE
                        </button>

                        <form method="post"
                              asp-page-handler="DeleteVehicle"
                              onsubmit="return confirm('Remove this vehicle from your PonyUp Garage?');">
                            <input type="hidden"
                                   name="vehicleId"
                                   value="@vehicle.Id" />

                            <button type="submit"
                                    class="garage-remove-action">
                                <span>×</span>
                                REMOVE VEHICLE
                            </button>
                        </form>
                    </div>
                </section>
            }

            <section class="garage-history-board"
                     id="garageHistory">
                <div class="garage-history-heading">
                    <div>
                        <h3>ANALYSIS HISTORY</h3>
                        <p>Your latest saved PonyUp decisions.</p>
                    </div>

                    <a asp-page="/DecisionCenter">
                        + NEW ANALYSIS
                    </a>
                </div>

                @if (Model.AllAnalyses.Count == 0)
                {
                    <p class="garage-muted">
                        No saved analyses are available on this account yet.
                    </p>
                }
                else
                {
                    <div class="garage-history-list">
                        @foreach (var analysis in Model.AllAnalyses)
                        {
                            <article class="garage-history-row">
                                <div class="garage-history-type">
                                    <span>@analysis.AnalysisType</span>
                                    <strong>@analysis.Recommendation</strong>
                                </div>

                                <div>
                                    <span>VEHICLE</span>
                                    <strong>
                                        @($"{analysis.VehicleYear} {analysis.VehicleMake} {analysis.VehicleModel}".Trim())
                                    </strong>
                                </div>

                                <div>
                                    <span>CONFIDENCE</span>
                                    <strong>@analysis.ConfidenceScore%</strong>
                                </div>

                                <div>
                                    <span>DATE</span>
                                    <strong>@analysis.CreatedOn.ToLocalTime().ToString("MMM d, yyyy")</strong>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </main>
    </div>

    <div id="garageAddVehicleModal"
         class="garage-modal"
         hidden
         aria-hidden="true">

        <div class="garage-modal-backdrop"
             data-close-garage-add></div>

        <section class="garage-modal-card"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="garageAddVehicleTitle">

            <div class="garage-modal-heading">
                <div>
                    <h2 id="garageAddVehicleTitle">ADD VEHICLE</h2>
                    <p>Use a previous VIN or enter one manually.</p>
                </div>

                <button type="button"
                        data-close-garage-add
                        aria-label="Close Add Vehicle">
                    ×
                </button>
            </div>

            <div id="garageRecentVinWrap"
                 class="garage-recent-vins"
                 hidden>
                <h3>RECENTLY DECODED VINs</h3>
                <div data-garage-vin-history-list></div>
            </div>

            <form method="post"
                  class="garage-add-form">

                <div class="garage-field garage-field-wide">
                    <label asp-for="NewVehicle.Vin">
                        VIN <span>optional</span>
                    </label>

                    <div class="garage-vin-row">
                        <input asp-for="NewVehicle.Vin"
                               maxlength="17"
                               autocomplete="off"
                               data-vin-history="true"
                               data-garage-vin-input
                               placeholder="17-character VIN" />

                        <button type="submit"
                                class="garage-secondary-button"
                                data-garage-decode
                                asp-page-handler="DecodeVin">
                            DECODE
                        </button>
                    </div>

                    <span asp-validation-for="NewVehicle.Vin"
                          class="garage-validation"></span>
                </div>

                <div class="garage-form-grid">
                    <div class="garage-field">
                        <label asp-for="NewVehicle.Year">Year</label>
                        <input asp-for="NewVehicle.Year"
                               min="0"
                               inputmode="numeric"
                               data-garage-year
                               placeholder="Year" />
                    </div>

                    <div class="garage-field">
                        <label asp-for="NewVehicle.Make">Make</label>
                        <input asp-for="NewVehicle.Make"
                               data-garage-make
                               placeholder="Make" />
                    </div>

                    <div class="garage-field">
                        <label asp-for="NewVehicle.Model">Model</label>
                        <input asp-for="NewVehicle.Model"
                               data-garage-model
                               placeholder="Model" />
                    </div>

                    <div class="garage-field">
                        <label asp-for="NewVehicle.Trim">Trim</label>
                        <input asp-for="NewVehicle.Trim"
                               placeholder="Trim" />
                    </div>

                    <div class="garage-field">
                        <label asp-for="NewVehicle.Mileage">Mileage</label>
                        <input asp-for="NewVehicle.Mileage"
                               min="0"
                               inputmode="numeric"
                               placeholder="Mileage" />
                    </div>

                    <div class="garage-field">
                        <label asp-for="NewVehicle.BodyStyle">Body Style</label>
                        <input asp-for="NewVehicle.BodyStyle"
                               placeholder="Sedan, coupe, truck..." />
                    </div>

                    <div class="garage-field">
                        <label asp-for="NewVehicle.Engine">Engine</label>
                        <input asp-for="NewVehicle.Engine"
                               placeholder="Engine" />
                    </div>

                    <div class="garage-field">
                        <label asp-for="NewVehicle.Drivetrain">Drivetrain</label>
                        <input asp-for="NewVehicle.Drivetrain"
                               placeholder="FWD, RWD, AWD..." />
                    </div>

                    <div class="garage-field garage-field-wide">
                        <label asp-for="NewVehicle.FuelType">Fuel Type</label>
                        <input asp-for="NewVehicle.FuelType"
                               placeholder="Gasoline, diesel..." />
                    </div>
                </div>

                <button type="submit"
                        class="btn-red garage-add-button"
                        asp-page-handler="AddVehicle">
                    ADD TO GARAGE
                </button>
            </form>
        </section>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.NewVehicle.Vin) &&
     Model.NewVehicle.Vin.Length == 17)
{
    <span hidden
          data-vin-history-record
          data-vin="@Model.NewVehicle.Vin"
          data-year="@(Model.NewVehicle.Year > 0 ? Model.NewVehicle.Year.ToString() : "")"
          data-make="@Model.NewVehicle.Make"
          data-model="@Model.NewVehicle.Model">
    </span>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (!string.IsNullOrWhiteSpace(carImagesApiKey))
    {
        <script src="https://carimagesapi.com/assets/js/carimages.js"
                data-api-key="@carImagesApiKey"></script>
    }

    <script type="module"
            src="~/js/garageVehicleViewer.js"
            asp-append-version="true"></script>
}
