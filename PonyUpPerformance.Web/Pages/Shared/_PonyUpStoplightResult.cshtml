@model PonyUpPerformance.Web.Models.PonyUpStoplightResultViewModel

@{
    int overallScore =
        Model.Score ?? Model.ConfidenceScore;

    string recommendation =
        (Model.Recommendation ?? string.Empty)
            .Trim()
            .ToUpperInvariant();

    string state =
        !Model.HasResult
            ? "off"
            : recommendation.Contains("PONY UP")
                ? "green"
                : recommendation.Contains("NEGOTIATE") ||
                  recommendation.Contains("CAUTION")
                    ? "yellow"
                    : recommendation.Contains("WALK AWAY") ||
                      recommendation.Contains("STOP")
                        ? "red"
                        : overallScore >= 75
                            ? "green"
                            : overallScore >= 50
                                ? "yellow"
                                : "red";

    string stoplightImage =
        state == "green"
            ? "~/images/ponyup-stoplight-green.png"
            : state == "yellow"
                ? "~/images/ponyup-stoplight-yellow.png"
                : state == "red"
                    ? "~/images/ponyup-stoplight-red.png"
                    : "~/images/ponyup-stoplight-off.png";

    string scoreText =
        Model.HasResult
            ? $"{overallScore}%"
            : "---";

    string confidence =
        !Model.HasResult
            ? "---"
            : Model.ConfidenceScore >= 85
                ? "HIGH"
                : Model.ConfidenceScore >= 65
                    ? "MODERATE"
                    : "LOW";

    string risk =
        !Model.HasResult
            ? "---"
            : !string.IsNullOrWhiteSpace(Model.RiskLevel)
                ? Model.RiskLevel.ToUpperInvariant()
                : state == "green"
                    ? "LOW"
                    : state == "yellow"
                        ? "MODERATE"
                        : "HIGH";

    bool hasPrimaryVehicle =
        !string.IsNullOrWhiteSpace(Model.PrimaryVehicleTitle) ||
        !string.IsNullOrWhiteSpace(Model.PrimaryVehicleDetails);

    bool hasSecondaryVehicle =
        !string.IsNullOrWhiteSpace(Model.SecondaryVehicleTitle) ||
        !string.IsNullOrWhiteSpace(Model.SecondaryVehicleDetails);
}

<div class="ponyup-stoplight-panel @state"
     data-analysis-result="@(Model.HasResult ? "true" : "false")"
     tabindex="@(Model.HasResult ? "-1" : null)">

    <div class="ponyup-stoplight-left">

        <img src="@Url.Content(stoplightImage)"
             class="ponyup-stoplight-art"
             alt="PonyUp Stoplight" />

    </div>

    <div class="ponyup-stoplight-center">

        <div class="ponyup-analysis-label">
            @Model.AnalysisType
        </div>

        <h2>@Model.Recommendation</h2>

        <div class="ponyup-score-label">
            OVERALL SCORE
        </div>

        <div class="ponyup-score">
            @scoreText
        </div>

        <div class="ponyup-meta-row">

            <div>
                <span>CONFIDENCE:</span>
                <strong>@confidence</strong>
            </div>

            <div>
                <span>RISK LEVEL:</span>
                <strong>@risk</strong>
            </div>

        </div>

        <div class="ponyup-reasoning-title">
            WHY WE RECOMMEND THIS
        </div>

        <p class="ponyup-result-reasoning">
            @Model.Reasoning
        </p>

    </div>

    <div class="ponyup-stoplight-legend">

        <h3>WHAT YOUR RESULT MEANS</h3>

        <div class="ponyup-legend-card red">
            <strong>STOP / WALK AWAY</strong>
            <span>High Risk</span>
            <p>The decision factors show significant concerns.</p>
        </div>

        <div class="ponyup-legend-card yellow">
            <strong>PROCEED WITH CAUTION</strong>
            <span>Moderate Risk</span>
            <p>Negotiate, verify, or investigate before committing.</p>
        </div>

        <div class="ponyup-legend-card green">
            <strong>PONY UP</strong>
            <span>Strong Position</span>
            <p>The available evidence supports the decision.</p>
        </div>

        @if (hasPrimaryVehicle &&
             !hasSecondaryVehicle)
        {
            <div class="ponyup-result-vehicle-card single">
                <span>VEHICLE</span>
                <strong>@Model.PrimaryVehicleTitle</strong>

                @if (!string.IsNullOrWhiteSpace(
                    Model.PrimaryVehicleDetails))
                {
                    <p>@Model.PrimaryVehicleDetails</p>
                }
            </div>
        }

    </div>

</div>

@if (hasPrimaryVehicle &&
     hasSecondaryVehicle)
{
    <div class="ponyup-result-vehicle-pair">

        <div class="ponyup-result-vehicle-card">
            <span>YOUR VEHICLE</span>
            <strong>@Model.PrimaryVehicleTitle</strong>

            @if (!string.IsNullOrWhiteSpace(
                Model.PrimaryVehicleDetails))
            {
                <p>@Model.PrimaryVehicleDetails</p>
            }
        </div>

        <div class="ponyup-result-vehicle-card">
            <span>THEIR VEHICLE</span>
            <strong>@Model.SecondaryVehicleTitle</strong>

            @if (!string.IsNullOrWhiteSpace(
                Model.SecondaryVehicleDetails))
            {
                <p>@Model.SecondaryVehicleDetails</p>
            }
        </div>

    </div>
}
