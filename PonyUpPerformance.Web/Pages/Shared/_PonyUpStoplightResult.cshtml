@model PonyUpPerformance.Web.Models.PonyUpStoplightResultViewModel

@{
    int overallScore =
        Model.Score ?? Model.ConfidenceScore;

    string recommendationKey =
        (Model.Recommendation ?? string.Empty)
        .Trim()
        .ToUpperInvariant();

    string state =
        !Model.HasResult
            ? "off"
            : recommendationKey.Contains("PONY UP")
                ? "green"
                : recommendationKey.Contains("WALK AWAY") ||
                  recommendationKey == "STOP"
                    ? "red"
                    : "yellow";

    string stoplightImage =
        state == "green"
            ? "~/images/ponyup-stoplight-green.png"
            : state == "yellow"
                ? "~/images/ponyup-stoplight-yellow.png"
                : state == "red"
                    ? "~/images/ponyup-stoplight-red.png"
                    : "~/images/ponyup-stoplight-off.png";

    string scoreText =
        Model.HasResult
            ? $"{overallScore}%"
            : "---";

    string confidence =
        !Model.HasResult
            ? "---"
            : Model.ConfidenceScore >= 85
                ? "HIGH"
                : Model.ConfidenceScore >= 65
                    ? "MODERATE"
                    : "LOW";

    string risk =
        !Model.HasResult
            ? "---"
            : !string.IsNullOrWhiteSpace(Model.RiskLevel)
                ? Model.RiskLevel.ToUpperInvariant()
                : state == "green"
                    ? "LOW"
                    : state == "yellow"
                        ? "MODERATE"
                        : "HIGH";
}

@if (Model.HasResult)
{
    <img src="~/images/ponyup-stoplight-banner.png"
         alt="PonyUp Stoplight"
         style="
            display:block;
            width:100%;
            max-width:1200px;
            height:auto;
            margin:0 auto 18px auto;
            border-radius:12px;" />
}

<div class="ponyup-stoplight-panel @state">

    <div class="ponyup-stoplight-left">

        <img src="@Url.Content(stoplightImage)"
             class="ponyup-stoplight-art"
             alt="PonyUp Stoplight" />

    </div>

    <div class="ponyup-stoplight-center">

        <div class="ponyup-analysis-label">
            @Model.AnalysisType
        </div>

        <h2>@Model.Recommendation</h2>

        <div class="ponyup-score-label">
            OVERALL SCORE
        </div>

        <div class="ponyup-score">
            @scoreText
        </div>

        <div class="ponyup-meta-row">

            <div>
                <span>CONFIDENCE:</span>
                <strong>@confidence</strong>
            </div>

            <div>
                <span>RISK LEVEL:</span>
                <strong>@risk</strong>
            </div>

        </div>

        <div class="ponyup-reasoning-title">
            WHY WE RECOMMEND THIS
        </div>

        <p class="ponyup-result-reasoning">
            @Model.Reasoning
        </p>

    </div>

    <div class="ponyup-stoplight-legend">

        <h3>WHAT YOUR RESULT MEANS</h3>

        <div class="ponyup-legend-card red">
            <strong>STOP / WALK AWAY</strong>
            <span>High Risk</span>
            <p>
                The decision factors show significant concerns.
            </p>
        </div>

        <div class="ponyup-legend-card yellow">
            <strong>PROCEED WITH CAUTION</strong>
            <span>Moderate Risk</span>
            <p>
                Negotiate, verify, or investigate before committing.
            </p>
        </div>

        <div class="ponyup-legend-card green">
            <strong>PONY UP</strong>
            <span>Strong Position</span>
            <p>
                The available evidence supports the decision.
            </p>
        </div>

    </div>

</div>
