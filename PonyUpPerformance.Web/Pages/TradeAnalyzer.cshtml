                                </label>

                                <select asp-for="Input.TheirRuns">

                                    <option value="">
                                        Not Provided
                                    </option>

                                    <option value="true">
                                        Yes
                                    </option>

                                    <option value="false">
                                        No
                                    </option>

                                </select>

                            </div>

                            <div class="trade-history-field">

                                <label>
                                    Drives
                                </label>

                                <select asp-for="Input.TheirDrives">

                                    <option value="">
                                        Not Provided
                                    </option>

                                    <option value="true">
                                        Yes
                                    </option>

                                    <option value="false">
                                        No
                                    </option>

                                </select>

                            </div>

                            <div class="trade-history-field">

                                <label>
                                    Repairs
                                </label>

                                <input asp-for="Input.TheirEstimatedRepairCost"
                                       placeholder="$0" />

                            </div>

                        </div>

                    </details>

                </div>

            </div>


            <!-- ============================
                 SIDE-BY-SIDE SPEC TABLE
                 ============================ -->

