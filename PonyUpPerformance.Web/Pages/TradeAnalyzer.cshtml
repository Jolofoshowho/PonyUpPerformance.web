@page
@model PonyUpPerformance.Web.Pages.TradeAnalyzerModel

@{
    ViewData["Title"] = "Trade Analyzer";

    var stoplight =
        new PonyUpPerformance.Web.Models.PonyUpStoplightResultViewModel
        {
            HasResult =
                Model.Result != null,

            AnalysisType =
                "TRADE DECISION",

            Score =
                Model.Result?.Score,

            Recommendation =
                Model.Result?.Recommendation
                ?? "READY",

            ConfidenceScore =
                Model.Result?.ConfidenceScore
                ?? 0,

            RiskLevel =
                Model.Result?.RiskLevel
                ?? string.Empty,

            Reasoning =
                Model.Result?.Reasoning
                ?? "Compare both vehicles and run the trade analysis."
        };

    string Money(decimal? value)
    {
        return value.HasValue
            ? value.Value.ToString("C0")
            : "—";
    }

    bool HasVehicleIdentity(
        int? year,
        string? make,
        string? model)
    {
        return year.HasValue ||
               !string.IsNullOrWhiteSpace(make) ||
               !string.IsNullOrWhiteSpace(model);
    }

    string ShortYear(
        int? year)
    {
        return year.HasValue
            ? $"'{year.Value % 100:00}"
            : string.Empty;
    }

    string VehicleTopLine(
        int? year,
        string? make)
    {
        string yearText =
            ShortYear(year);

        string makeText =
            make?.Trim()
            ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(yearText) &&
            !string.IsNullOrWhiteSpace(makeText))
        {
            return $"{yearText} {makeText}";
        }

        if (!string.IsNullOrWhiteSpace(yearText))
        {
            return yearText;
        }

        return makeText;
    }

    bool hasYourIdentity =
        HasVehicleIdentity(
            Model.Input.YourYear,
            Model.Input.YourMake,
            Model.Input.YourModel);

    bool hasTheirIdentity =
        HasVehicleIdentity(
            Model.Input.TheirYear,
            Model.Input.TheirMake,
            Model.Input.TheirModel);
}

<section class="page-section analyzer-page trade-bg">

    <img class="analyzer-banner"
         src="/images/TradeAnal.png"
         alt="PonyUp Performance Trade Analyzer" />

    <div class="trade-compare-shell">

