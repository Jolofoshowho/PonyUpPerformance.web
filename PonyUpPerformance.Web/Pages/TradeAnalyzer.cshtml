            <!-- ============================
                 TRADE CASH
                 ============================ -->

            <div class="trade-cash-grid">

                <div>

                    <label>
                        CASH YOU ADD
                    </label>

                    <input asp-for="Input.CashYouAdd"
                           placeholder="$0" />

                </div>

                <div>

                    <label>
                        CASH THEY ADD
                    </label>

                    <input asp-for="Input.CashTheyAdd"
                           placeholder="$0" />

                </div>

            </div>


            <div class="trade-analyze-action">

                <button type="submit"
                        class="btn-red"
                        asp-page-handler="Analyze">

                    ANALYZE TRADE

