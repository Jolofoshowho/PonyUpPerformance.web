            </div>

        </form>


        @if (Model.Result != null)
        {
            <div class="trade-result-summary">

                <div>

                    <span>
                        YOUR ADJUSTED VALUE
                    </span>

                    <strong>
                        @Money(
                            Model.Result.YourAdjustedValue)
                    </strong>

                </div>

                <div>

                    <span>
                        NET TRADE POSITION
                    </span>

                    <strong>
                        @Money(
                            Model.Result.NetTradePosition)
