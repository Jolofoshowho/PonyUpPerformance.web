                                asp-page-handler="DecodeYourVin"
                                formnovalidate>

                            DECODE

                        </button>

                    </div>

                    <span asp-validation-for="Input.YourVin"
                          class="text-danger trade-mini-message">
                    </span>

                    @if (!string.IsNullOrWhiteSpace(
                        Model.YourVinMessage))
                    {
                        <div class="trade-mini-message">
                            @Model.YourVinMessage
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(
                        Model.YourValueMessage))
                    {
                        <div class="trade-mini-message value">
                            @Model.YourValueMessage
                        </div>
                    }

                    <details class="trade-history">

                        <summary>
                            VEHICLE HISTORY ›
                        </summary>

                        <div class="trade-history-panel">

                            <div class="trade-history-field">

                                <label>
                                    Title
                                </label>

                                <select asp-for="Input.YourTitleStatus">

                                    <option value="-1">
                                        Not Provided
                                    </option>

                                    <option value="0">
                                        Clean
                                    </option>

                                    <option value="1">
                                        Rebuilt
                                    </option>

                                    <option value="2">
                                        Salvage
                                    </option>

                                    <option value="3">
                                        Flood
                                    </option>

                                </select>

                            </div>

                            <div class="trade-history-field">

                                <label>
                                    Accident
                                </label>

                                <select asp-for="Input.YourAccidentHistory">

                                    <option value="-1">
                                        Not Provided
                                    </option>

                                    <option value="0">
                                        None
                                    </option>

                                    <option value="1">
                                        Minor
                                    </option>

                                    <option value="2">
                                        Moderate
                                    </option>

                                    <option value="3">
                                        Major
                                    </option>

                                </select>

                            </div>

                            <div class="trade-history-field">

                                <label>
                                    Runs
                                </label>

                                <select asp-for="Input.YourRuns">

                                    <option value="">
                                        Not Provided
                                    </option>

                                    <option value="true">
                                        Yes
                                    </option>

                                    <option value="false">
                                        No
                                    </option>

                                </select>

                            </div>

                            <div class="trade-history-field">

                                <label>
                                    Drives
                                </label>

                                <select asp-for="Input.YourDrives">

                                    <option value="">
                                        Not Provided
                                    </option>

                                    <option value="true">
                                        Yes
                                    </option>

                                    <option value="false">
                                        No
                                    </option>

                                </select>

                            </div>

                            <div class="trade-history-field">

                                <label>
                                    Repairs
                                </label>

                                <input asp-for="Input.YourEstimatedRepairCost"
                                       placeholder="$0" />

                            </div>

                        </div>

                    </details>

                </div>


