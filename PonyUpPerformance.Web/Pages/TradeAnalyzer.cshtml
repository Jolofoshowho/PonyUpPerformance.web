                <div class="trade-spec-row">

                    <div class="trade-spec-value unit">

                        <input asp-for="Input.YourMileage"
                               aria-label="Your mileage"
                               placeholder="—" />

                        <span>MI</span>

                    </div>

                    <div class="trade-spec-label">
                        MILEAGE
                    </div>

                    <div class="trade-spec-value unit">

                        <input asp-for="Input.TheirMileage"
                               aria-label="Their mileage"
                               placeholder="—" />

                        <span>MI</span>

                    </div>

                </div>


                <div class="trade-spec-row">

                    <div class="trade-spec-value trade-mpg">

                        <input asp-for="Input.YourCityMpg"
                               aria-label="Your city MPG"
                               placeholder="City" />

                        <span>/</span>

                        <input asp-for="Input.YourHighwayMpg"
                               aria-label="Your highway MPG"
                               placeholder="Hwy" />

                    </div>

                    <div class="trade-spec-label">
                        MPG C/H
                    </div>

                    <div class="trade-spec-value trade-mpg">

                        <input asp-for="Input.TheirCityMpg"
                               aria-label="Their city MPG"
                               placeholder="City" />

                        <span>/</span>

                        <input asp-for="Input.TheirHighwayMpg"
                               aria-label="Their highway MPG"
                               placeholder="Hwy" />

                    </div>

                </div>


                <div class="trade-spec-row">

                    <div class="trade-spec-value unit">

                        <input asp-for="Input.YourCurbWeightLbs"
                               aria-label="Your curb weight"
                               placeholder="—" />

                        <span>LB</span>

                    </div>

                    <div class="trade-spec-label">
                        CURB WEIGHT
                    </div>

                    <div class="trade-spec-value unit">

                        <input asp-for="Input.TheirCurbWeightLbs"
                               aria-label="Their curb weight"
                               placeholder="—" />

                        <span>LB</span>

                    </div>

                </div>


                <div class="trade-spec-row trade-condition-row">

                    <div class="trade-spec-value">

                        <select asp-for="Input.YourCondition"
                                aria-label="Your vehicle condition">

                            <option value="-1">
