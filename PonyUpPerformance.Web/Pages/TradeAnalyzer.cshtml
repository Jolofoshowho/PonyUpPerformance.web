                    <div class="trade-market-label">
                        MARKET VALUE
                    </div>

                    <div class="trade-market-value">

                        <span>$</span>

                        <input asp-for="Input.YourValue"
                               aria-label="Your vehicle market value"
                               placeholder="0" />

                    </div>

                    <div class="trade-name-line"
     style="display:flex;justify-content:center;align-items:center;gap:4px;">

    <input asp-for="Input.YourYear"
           class="trade-year"
           aria-label="Your vehicle year"
           placeholder="Year"
           style="width:6ch !important;flex:0 0 auto;" />

    <input asp-for="Input.YourMake"
           class="trade-make"
           aria-label="Your vehicle make"
           placeholder="Make"
           style="width:14ch !important;flex:0 0 auto;" />

</div>

<input asp-for="Input.YourModel"
       class="trade-model"
       aria-label="Your vehicle model"
       placeholder="Model" />

<input asp-for="Input.YourTrim"
       class="trade-trim"
       aria-label="Your vehicle trim"
       placeholder="Trim" />

                    <div class="trade-vin-row">

                        <input asp-for="Input.YourVin"
                               maxlength="17"
                               aria-label="Your vehicle VIN"
                               placeholder="VIN" />

                        <button type="submit"
