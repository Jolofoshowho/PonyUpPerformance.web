                                </label>

                                <select asp-for="Input.TheirAccidentHistory">

                                    <option value="-1">
                                        Not Provided
                                    </option>

                                    <option value="0">
                                        None
                                    </option>

                                    <option value="1">
                                        Minor
                                    </option>

                                    <option value="2">
                                        Moderate
                                    </option>

                                    <option value="3">
                                        Major
                                    </option>

                                </select>

                            </div>

                            <div class="trade-history-field">

