@page
@model PonyUpPerformance.Web.Pages.PricingPageModel

@{
    ViewData["Title"] = "Pricing";
}

<section class="page-section pricing-section pricing-page-v2">
    <div class="pricing-page-head">
        <p class="pricing-eyebrow">PONYUP PERFORMANCE</p>
        <h1 class="section-title">PRICING</h1>
        <p class="section-subtitle">
            Start free. Every account gets the Garage. Upgrade when you need more decisions.
        </p>
    </div>

    <partial name="_PricingCards" />

    <section class="pricing-capability-section">
        <div class="pricing-capability-card">
            <span class="pricing-capability-icon">3D</span>
            <h2>REALISTIC GARAGE</h2>
            <p>
                Supported vehicles load as realistic interactive 3D models on the PonyUp spinner podium.
            </p>
        </div>

        <div class="pricing-capability-card">
            <span class="pricing-capability-icon">✦</span>
            <h2>MAKE IT YOURS</h2>
            <p>
                PonyUp 3D models can expose exterior paint, interior color/material, wheel style, and wheel finish choices.
            </p>
        </div>

        <div class="pricing-capability-card">
            <span class="pricing-capability-icon">↻</span>
            <h2>VEHICLE HISTORY</h2>
            <p>
                Keep saved vehicles, VIN history, mileage, and PonyUp analysis history together in My Garage.
            </p>
        </div>
    </section>

    <p class="pricing-model-note">
        3D vehicle and customization availability depends on the PonyUp model catalog for the selected year, make, model, and trim.
    </p>
</section>
