@page
@model PonyUpPerformance.Web.Pages.PricingPageModel

@{
    ViewData["Title"] = "Pricing";
}

<section class="page-section pricing-section pricing-page-v2">
    <div class="pricing-page-head">
        <p class="pricing-eyebrow">PONYUP PERFORMANCE</p>
        <h1 class="section-title">PRICING</h1>
        <p class="section-subtitle">
            Start free. Step up only when you need more analyses, more Garage control, or deeper vehicle intelligence.
        </p>
    </div>

    <partial name="_PricingCards" />

    <section class="pricing-capability-section">
        <div class="pricing-capability-card">
            <span class="pricing-capability-icon">3D</span>
            <h2>REALISTIC GARAGE</h2>
            <p>
                Quick Pack and above unlock realistic interactive 3D models on supported vehicles.
            </p>
        </div>

        <div class="pricing-capability-card">
            <span class="pricing-capability-icon">✦</span>
            <h2>MAKE IT YOURS</h2>
            <p>
                Quick Pack and Pro get exterior paint. Full Throttle and above unlock interior, wheels, and special appearance variants.
            </p>
        </div>

        <div class="pricing-capability-card">
            <span class="pricing-capability-icon">↻</span>
            <h2>VEHICLE HISTORY</h2>
            <p>
                Every account keeps saved vehicles, VIN details, mileage, and PonyUp analysis history together in My Garage.
            </p>
        </div>
    </section>

    <p class="pricing-model-note">
        3D vehicle and customization availability depends on the PonyUp model catalog for the selected year, make, model, and trim. Redline features are shown as coming soon until premium report-provider pricing is finalized.
    </p>
</section>
