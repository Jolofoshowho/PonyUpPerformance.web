@page
@model PonyUpPerformance.Web.Pages.RepairAnalyzerModel

@{
    ViewData["Title"] = "Repair Analyzer";

    string recommendation =
        Model.Result?.Recommendation
        ?? "READY";

    string reasoning =
        Model.Result?.Reasoning
        ?? "Enter the repair details and run the analysis.";

    bool hasEstimate =
        Model.EstimateResult != null;

    bool hasResult =
        Model.Result != null;

    string estimateInputStyle =
        hasEstimate || hasResult
            ? "max-width:900px;margin:0 auto;display:none;"
            : "max-width:900px;margin:0 auto;";

    string decisionPanelStyle =
        hasEstimate && !hasResult
            ? "max-width:900px;margin:0 auto;"
            : "max-width:900px;margin:0 auto;display:none;";

    var stoplight =
        new PonyUpPerformance.Web.Models.PonyUpStoplightResultViewModel
        {
            HasResult = hasResult,
            AnalysisType = "REPAIR DECISION",
            Score = Model.Result?.Score,
            Recommendation = recommendation,
            ConfidenceScore =
                Model.Result?.ConfidenceScore ?? 0,
            RiskLevel =
                Model.Result?.RiskLevel ?? string.Empty,
            Reasoning = reasoning
        };
}

<section class="page-section analyzer-page repair-bg">

    <h1 class="section-title">
        REPAIR ANALYZER
    </h1>

    <p class="section-subtitle">
        Know before you spend. Determine whether repairing
        this vehicle makes financial sense.
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.CreditMessage))
    {
        <div class="price-card featured"
             style="max-width:900px;margin:0 auto 24px;">

            <p>
                @Model.CreditMessage
            </p>

        </div>
    }

    @*
        STAGE 1
        Vehicle + repair estimate inputs.
        Hidden after a successful estimate.
    *@

    <div id="repair-estimate-input-panel"
         class="price-card analyzer-card"
         style="@estimateInputStyle">

        <form method="post"
              class="analyzer-form">

            <input asp-for="EstimateCreditConsumed"
                   type="hidden" />

            <h2>
                VEHICLE INFORMATION
            </h2>

            <div class="form-row">

                <label asp-for="Input.Vin">
                    VIN
                </label>

                <input asp-for="Input.Vin"
                       maxlength="17"
                       autocomplete="off"
                       style="text-transform:uppercase;" />

                <span asp-validation-for="Input.Vin"
                      class="text-danger">
                </span>

            </div>

            <div class="form-actions"
                 style="margin-top:10px;margin-bottom:20px;">

                <button class="btn-red"
                        type="submit"
                        asp-page-handler="DecodeVin"
                        formnovalidate>

                    DECODE VIN

                </button>

            </div>

            @if (!string.IsNullOrWhiteSpace(
                Model.VinDecodeMessage))
            {
                <p style="font-weight:700;">
                    @Model.VinDecodeMessage
                </p>
            }

            <div class="form-row">

                <label for="Input_VehicleYear">
                    Year
                </label>

                <input id="Input_VehicleYear"
                       name="Input.VehicleYear"
                       type="number"
                       min="1886"
                       max="2100"
                       placeholder="Year"
                       value="@(Model.Input.VehicleYear > 0
                           ? Model.Input.VehicleYear.ToString()
                           : string.Empty)" />

            </div>

            <div class="form-row">

                <label asp-for="Input.VehicleMake">
                    Make
                </label>

                <input asp-for="Input.VehicleMake" />

            </div>

            <div class="form-row">

                <label asp-for="Input.VehicleModel">
                    Model
                </label>

                <input asp-for="Input.VehicleModel" />

            </div>

            <div class="analyzer-section-divider">
            </div>

            <h2>
                REPAIR COST ESTIMATE
            </h2>

            <div class="form-row">

                <label asp-for="EstimateInput.City">
                    City
                </label>

                <input asp-for="EstimateInput.City" />

            </div>

            <div class="form-row">

                <label asp-for="EstimateInput.State">
                    State
                </label>

                <input asp-for="EstimateInput.State" />

            </div>

            <div class="form-row">

                <label asp-for="EstimateInput.ZipCode">
                    ZIP Code
                </label>

                <input asp-for="EstimateInput.ZipCode" />

            </div>

            <div class="form-row">

                <label asp-for="EstimateInput.RepairType">
                    Repair Type
                </label>

                <select asp-for="EstimateInput.RepairType">

                    @foreach (
                        string repairType
                        in Model.RepairTypes)
                    {
                        <option value="@repairType">
                            @repairType
                        </option>
                    }

                </select>

            </div>

            <div class="form-check-row">

                <label>

                    <input asp-for="EstimateInput.IncludeDiagnosticFee" />

                    Include Diagnostic Fee

                </label>

                <label>

                    <input asp-for="EstimateInput.IncludeTowFee" />

                    Include Tow Fee

                </label>

            </div>

            <div class="form-actions">

                <button class="btn-red"
                        type="submit"
                        asp-page-handler="Estimate"
                        onclick="return confirm('Does all of the information look correct? Estimating the repair cost will use one analysis credit.');">

                    ESTIMATE REPAIR COST

                </button>

            </div>

        </form>

    </div>

    @*
        STAGE 2
        Successful estimate replaces Stage 1.

        The estimate is shown first.
        Expected Estimate automatically fills Repair Cost.
        User only completes the remaining decision fields.
    *@

    @if (Model.EstimateResult != null)
    {
        <div id="repair-decision-panel"
             class="price-card analyzer-card"
             style="@decisionPanelStyle">

            <form method="post"
                  class="analyzer-form">

                <input asp-for="EstimateCreditConsumed"
                       type="hidden" />

                @*
                    Preserve vehicle identity between stages.
                *@

                <input asp-for="Input.Vin"
                       type="hidden" />

                <input asp-for="Input.VehicleYear"
                       type="hidden" />

                <input asp-for="Input.VehicleMake"
                       type="hidden" />

                <input asp-for="Input.VehicleModel"
                       type="hidden" />

                @*
                    Preserve the estimate result through the
                    Analyze post so Edit Analysis remains usable.
                *@

                <input asp-for="EstimateResult.RepairType"
                       type="hidden" />

                <input asp-for="EstimateResult.LocationUsed"
                       type="hidden" />

                <input asp-for="EstimateResult.LaborRateLow"
                       type="hidden" />

                <input asp-for="EstimateResult.LaborRateAverage"
                       type="hidden" />

                <input asp-for="EstimateResult.LaborRateHigh"
                       type="hidden" />

                <input asp-for="EstimateResult.LaborHoursLow"
                       type="hidden" />

                <input asp-for="EstimateResult.LaborHoursAverage"
                       type="hidden" />

                <input asp-for="EstimateResult.LaborHoursHigh"
                       type="hidden" />

                <input asp-for="EstimateResult.PartsLow"
                       type="hidden" />

                <input asp-for="EstimateResult.PartsAverage"
                       type="hidden" />

                <input asp-for="EstimateResult.PartsHigh"
                       type="hidden" />

                <input asp-for="EstimateResult.ShopFeeAverage"
                       type="hidden" />

                <input asp-for="EstimateResult.SalesTaxRate"
                       type="hidden" />

                <input asp-for="EstimateResult.DiagnosticFee"
                       type="hidden" />

                <input asp-for="EstimateResult.TowFee"
                       type="hidden" />

                <input asp-for="EstimateResult.LowEstimate"
                       type="hidden" />

                <input asp-for="EstimateResult.ExpectedEstimate"
                       type="hidden" />

                <input asp-for="EstimateResult.HighEstimate"
                       type="hidden" />

                <input asp-for="EstimateResult.EstimateNote"
                       type="hidden" />

                <h2>
                    REPAIR COST ESTIMATE
                </h2>

                <p style="font-size:1.05rem;font-weight:800;">
                    @if (Model.Input.VehicleYear > 0)
                    {
                        @Model.Input.VehicleYear
                        <text> </text>
                    }

                    @Model.Input.VehicleMake
                    @Model.Input.VehicleModel
                </p>

                <p>
                    <strong>Repair:</strong>
                    @Model.EstimateResult.RepairType
                </p>

                <p>
                    <strong>Location:</strong>
                    @Model.EstimateResult.LocationUsed
                </p>

                <div class="analyzer-section-divider">
                </div>

                <p>
                    <strong>Low Estimate:</strong>
                    @Model.EstimateResult.LowEstimate.ToString("C")
                </p>

                <p style="font-size:1.15rem;">
                    <strong>Expected Estimate:</strong>
                    @Model.EstimateResult.ExpectedEstimate.ToString("C")
                </p>

                <p>
                    <strong>High Estimate:</strong>
                    @Model.EstimateResult.HighEstimate.ToString("C")
                </p>

                <div class="analyzer-section-divider">
                </div>

                <p>
                    <strong>Average Labor Rate:</strong>
                    @Model.EstimateResult.LaborRateAverage.ToString("C")
                    per hour
                </p>

                <p>
                    <strong>Average Labor Time:</strong>
                    @Model.EstimateResult.LaborHoursAverage hours
                </p>

                <p>
                    <strong>Average Parts Cost:</strong>
                    @Model.EstimateResult.PartsAverage.ToString("C")
                </p>

                <p>
                    <strong>Average Shop Fee:</strong>
                    @Model.EstimateResult.ShopFeeAverage.ToString("C")
                </p>

                @if (Model.EstimateResult.DiagnosticFee > 0)
                {
                    <p>
                        <strong>Diagnostic Fee:</strong>
                        @Model.EstimateResult.DiagnosticFee.ToString("C")
                    </p>
                }

                @if (Model.EstimateResult.TowFee > 0)
                {
                    <p>
                        <strong>Tow Fee:</strong>
                        @Model.EstimateResult.TowFee.ToString("C")
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(
                    Model.EstimateResult.EstimateNote))
                {
                    <p>
                        @Model.EstimateResult.EstimateNote
                    </p>
                }

                <div class="analyzer-section-divider">
                </div>

                <h2>
                    COMPLETE REPAIR DECISION
                </h2>

                <p>
                    PonyUp has filled Repair Cost with the
                    expected estimate. Adjust it only if you
                    have a more accurate quote.
                </p>

                <div class="form-row">

                    <label asp-for="Input.RepairCost">
                        Repair Cost
                    </label>

                    <input asp-for="Input.RepairCost" />

                </div>

                <div class="form-row">

                    <label asp-for="Input.Mileage">
                        Mileage
                    </label>

                    <input asp-for="Input.Mileage" />

                </div>

                <div class="form-row">

                    <label asp-for="Input.VehicleValue">
                        Estimated Vehicle Value
                    </label>

                    <input asp-for="Input.VehicleValue" />

                </div>

                <div class="form-row">

                    <label asp-for="Input.Condition">
                        Overall Vehicle Condition
                    </label>

                    <select asp-for="Input.Condition">

                        <option value="Poor">
                            Poor
                        </option>

                        <option value="Fair">
                            Fair
                        </option>

                        <option value="Good">
                            Good
                        </option>

                        <option value="Excellent">
                            Excellent
                        </option>

                    </select>

                </div>

                <div class="form-row">

                    <label asp-for="Input.OwnershipYears">
                        Years You Plan to Keep It
                    </label>

                    <input asp-for="Input.OwnershipYears" />

                </div>

                <div class="form-check-row single-check">

                    <label>

                        <input asp-for="Input.IsSafetyCritical" />

                        Safety-Critical Repair

                    </label>

                </div>

                <div class="form-actions">

                    <button class="btn-red"
                            type="submit"
                            asp-page-handler="Analyze">

                        ANALYZE REPAIR

                    </button>

                    <button class="btn-dark"
                            type="button"
                            onclick="changeRepairEstimate()">

                        CHANGE ESTIMATE

                    </button>

                </div>

            </form>

        </div>
    }

    @*
        STAGE 3
        Analysis replaces Stage 2.
        PonyUp Stoplight is the primary result.
    *@

    @if (Model.Result != null)
    {
        <div id="repair-result-panel">

            <partial name="_PonyUpStoplightResult"
                     model="stoplight" />

            <div class="price-card featured"
                 style="max-width:900px;margin:20px auto 0;">

                <h2>
                    REPAIR DECISION DETAILS
                </h2>

                <p>
                    <strong>Financial Impact:</strong>
                    @Model.Result.FinancialImpact
                </p>

                @if (Model.Result.NextSteps != null &&
                     Model.Result.NextSteps.Count > 0)
                {
                    <div class="analyzer-section-divider">
                    </div>

                    <h3>
                        NEXT STEPS
                    </h3>

                    <ul>

                        @foreach (
                            string nextStep
                            in Model.Result.NextSteps)
                        {
                            <li>
                                @nextStep
                            </li>
                        }

                    </ul>
                }

            </div>

            <div class="form-actions"
                 style="max-width:900px;margin:20px auto;">

                <button type="button"
                        class="btn-dark"
                        onclick="editRepairAnalysis()">

                    EDIT ANALYSIS

                </button>

            </div>

        </div>
    }

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        function changeRepairEstimate() {

            const estimateInput =
                document.getElementById(
                    "repair-estimate-input-panel");

            const decisionPanel =
                document.getElementById(
                    "repair-decision-panel");

            if (decisionPanel) {
                decisionPanel.style.display = "none";
            }

            if (estimateInput) {

                estimateInput.style.display = "block";

                estimateInput.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });
            }
        }

        function editRepairAnalysis() {

            const resultPanel =
                document.getElementById(
                    "repair-result-panel");

            const decisionPanel =
                document.getElementById(
                    "repair-decision-panel");

            if (resultPanel) {
                resultPanel.style.display = "none";
            }

            if (decisionPanel) {

                decisionPanel.style.display = "block";

                decisionPanel.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });
            }
        }

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const resultPanel =
                    document.getElementById(
                        "repair-result-panel");

                const decisionPanel =
                    document.getElementById(
                        "repair-decision-panel");

                if (resultPanel) {

                    resultPanel.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });

                    return;
                }

                if (decisionPanel &&
                    decisionPanel.style.display !== "none") {

                    decisionPanel.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                }
            });

    </script>
}
