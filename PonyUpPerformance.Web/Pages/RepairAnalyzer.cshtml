@page
@model PonyUpPerformance.Web.Pages.RepairAnalyzerModel

@{
    ViewData["Title"] = "Repair Analyzer";

    string recommendation =
        Model.Result?.Recommendation
        ?? "READY";

    string reasoning =
        Model.Result?.Reasoning
        ?? "Enter the repair details and run the analysis.";

    string Money(decimal value)
    {
        return value.ToString(
            "C",
            System.Globalization.CultureInfo.GetCultureInfo("en-US"));
    }

    string Hours(decimal value)
    {
        return value.ToString("0.##");
    }

    var stoplight =
        new PonyUpPerformance.Web.Models.PonyUpStoplightResultViewModel
        {
            HasResult =
                Model.WorkflowStage == 3 &&
                Model.Result != null,

            AnalysisType =
                "REPAIR DECISION",

            Score =
                Model.Result?.Score,

            Recommendation =
                recommendation,

            ConfidenceScore =
                Model.Result?.ConfidenceScore ?? 0,

            RiskLevel =
                Model.Result?.RiskLevel ?? string.Empty,

            Reasoning =
                reasoning
        };
}

<style>

    /*
     * REPAIR ANALYZER FORM LAYOUT
     *
     * Overrides the site's global 220px label column
     * only inside the Repair Analyzer.
     */

    .repair-bg .analyzer-form {
        width: 100%;
    }

    .repair-bg .form-row {
        display: grid;

        grid-template-columns:
            minmax(260px, 340px)
            minmax(280px, 380px);

        justify-content: center;
        align-items: center;

        width: min(760px, 100%);

        margin-left: auto;
        margin-right: auto;
        margin-bottom: 16px;

        gap: 14px;
    }

    .repair-bg .form-row > label {
        width: 100%;

        white-space: normal;

        overflow: visible;

        text-overflow: unset;

        overflow-wrap: normal;

        word-break: normal;

        line-height: 1.15;

        text-align: right;
    }

    .repair-bg .form-row > input,
    .repair-bg .form-row > select {
        width: 100%;
        min-width: 0;
    }

    /*
     * Give the complete-decision section enough usable
     * width without changing the outer PonyUp card.
     */

    .repair-bg .analyzer-card {
        overflow: visible;
    }

    /*
     * Safety-critical checkbox gets its own centered row.
     */

    .repair-bg .single-check {
        width: min(720px, 100%);
        margin-left: auto;
        margin-right: auto;
        text-align: center;
    }

    /*
     * Mobile/tablet:
     * labels stack over their controls rather than
     * squeezing or clipping.
     */

    @@media (max-width: 760px) {

        .repair-bg .form-row {
            grid-template-columns: 1fr;

            width: 100%;

            gap: 7px;
        }

        .repair-bg .form-row > label {
            text-align: left;

            white-space: normal;
        }

        .repair-bg .form-row > input,
        .repair-bg .form-row > select {
            width: 100%;
        }
    }

</style>

<section class="page-section analyzer-page repair-bg">

    <img class="analyzer-banner"
     src="/images/RepairAnal.png"
     alt="PonyUp Performance Repair Analyzer" />

    @if (!string.IsNullOrWhiteSpace(
        Model.CreditMessage))
    {
        <div class="price-card featured"
             style="max-width:900px;margin:0 auto 24px;">

            <p>
                @Model.CreditMessage
            </p>

        </div>
    }

    @*
        ==================================================
        STAGE 1
        VEHICLE + REPAIR ESTIMATE INPUTS

        Decode VIN stays on Stage 1.
        Estimate Repair Cost is the only action that
        advances successfully to Stage 2.
        ==================================================
    *@

    @if (Model.WorkflowStage == 1)
    {
        <div class="price-card analyzer-card"
             style="max-width:900px;margin:0 auto;">

            <form method="post"
                  class="analyzer-form">

                <input asp-for="WorkflowStage"
                       type="hidden" />

                <input asp-for="EstimateCreditConsumed"
                       type="hidden" />

                <input asp-for="Input.RepairCost"
                       type="hidden" />

                <input asp-for="Input.Mileage"
                       type="hidden" />

                <input asp-for="Input.VehicleValue"
                       type="hidden" />

                <input asp-for="Input.Condition"
                       type="hidden" />

                <input asp-for="Input.OwnershipYears"
                       type="hidden" />

                <input asp-for="Input.IsSafetyCritical"
                       type="hidden" />

                <h2>
                    VEHICLE INFORMATION
                </h2>

                <div class="form-row">

                    <label asp-for="Input.Vin">
                        VIN
                    </label>

                    <input asp-for="Input.Vin"
                           maxlength="17"
                           autocomplete="off"
                           data-vin-history="true"
                           style="text-transform:uppercase;" />

                    <span asp-validation-for="Input.Vin"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-actions"
                     style="margin-top:10px;margin-bottom:20px;">

                    <button class="btn-red"
                            type="submit"
                            asp-page-handler="DecodeVin"
                            formnovalidate>

                        DECODE VIN

                    </button>

                </div>

                @if (!string.IsNullOrWhiteSpace(
                    Model.VinDecodeMessage))
                {
                    <p style="font-weight:700;">
                        @Model.VinDecodeMessage
                    </p>

                    @if (!string.IsNullOrWhiteSpace(
                        Model.Input.Vin))
                    {
                        <span hidden
                              data-vin-history-record
                              data-vin="@Model.Input.Vin"
                              data-year="@Model.Input.VehicleYear"
                              data-make="@Model.Input.VehicleMake"
                              data-model="@Model.Input.VehicleModel">
                        </span>
                    }
                }

                <div class="form-row">

                    <label for="Input_VehicleYear">
                        Year
                    </label>

                    <input id="Input_VehicleYear"
                           name="Input.VehicleYear"
                           type="number"
                           min="1886"
                           max="2100"
                           placeholder="Year"
                           value="@(Model.Input.VehicleYear > 0
                               ? Model.Input.VehicleYear.ToString()
                               : string.Empty)" />

                </div>

                <div class="form-row">

                    <label asp-for="Input.VehicleMake">
                        Make
                    </label>

                    <input asp-for="Input.VehicleMake" />

                </div>

                <div class="form-row">

                    <label asp-for="Input.VehicleModel">
                        Model
                    </label>

                    <input asp-for="Input.VehicleModel" />

                </div>

                <div class="analyzer-section-divider">
                </div>

                <h2>
                    REPAIR COST ESTIMATE
                </h2>

                <div class="form-row">

                    <label asp-for="EstimateInput.City">
                        City
                    </label>

                    <input asp-for="EstimateInput.City" />

                </div>

                <div class="form-row">

                    <label asp-for="EstimateInput.State">
                        State
                    </label>

                    <input asp-for="EstimateInput.State" />

                </div>

                <div class="form-row">

                    <label asp-for="EstimateInput.ZipCode">
                        ZIP Code
                    </label>

                    <input asp-for="EstimateInput.ZipCode" />

                </div>

                <div class="form-row">

                    <label asp-for="EstimateInput.RepairType">
                        Repair Type
                    </label>

                    <select asp-for="EstimateInput.RepairType">

                        @foreach (
                            string repairType
                            in Model.RepairTypes)
                        {
                            <option value="@repairType">
                                @repairType
                            </option>
                        }

                    </select>

                </div>

                <div class="form-check-row">

                    <label>

                        <input asp-for="EstimateInput.IncludeDiagnosticFee" />

                        Include Diagnostic Fee

                    </label>

                    <label>

                        <input asp-for="EstimateInput.IncludeTowFee" />

                        Include Tow Fee

                    </label>

                </div>

                <div class="form-actions">

                    <button class="btn-red"
                            type="submit"
                            asp-page-handler="Estimate"
                            onclick="return confirm('Does all of the information look correct? Estimating the repair cost will use one analysis credit.');">

                        ESTIMATE REPAIR COST

                    </button>

                </div>

            </form>

        </div>
    }

    @*
        ==================================================
        STAGE 2
        ACTUAL REPAIR ESTIMATE + DECISION INPUTS

        Appears ONLY after Estimate Repair Cost succeeds.
        ==================================================
    *@

    @if (Model.WorkflowStage == 2 &&
         Model.EstimateResult != null)
    {
        <div class="price-card analyzer-card"
             style="max-width:900px;margin:0 auto;">

            <form method="post"
                  class="analyzer-form">

                <input asp-for="WorkflowStage"
                       type="hidden" />

                <input asp-for="EstimateCreditConsumed"
                       type="hidden" />

                <input asp-for="Input.Vin"
                       type="hidden" />

                <input asp-for="Input.VehicleYear"
                       type="hidden" />

                <input asp-for="Input.VehicleMake"
                       type="hidden" />

                <input asp-for="Input.VehicleModel"
                       type="hidden" />

                <input asp-for="EstimateInput.City"
                       type="hidden" />

                <input asp-for="EstimateInput.State"
                       type="hidden" />

                <input asp-for="EstimateInput.ZipCode"
                       type="hidden" />

                <input asp-for="EstimateInput.RepairType"
                       type="hidden" />

                <input asp-for="EstimateInput.IncludeDiagnosticFee"
                       type="hidden" />

                <input asp-for="EstimateInput.IncludeTowFee"
                       type="hidden" />

                <input asp-for="EstimateResult.RepairType"
                       type="hidden" />

                <input asp-for="EstimateResult.LocationUsed"
                       type="hidden" />

                <input asp-for="EstimateResult.LaborRateLow"
                       type="hidden" />

                <input asp-for="EstimateResult.LaborRateAverage"
                       type="hidden" />

                <input asp-for="EstimateResult.LaborRateHigh"
                       type="hidden" />

                <input asp-for="EstimateResult.LaborHoursLow"
                       type="hidden" />

                <input asp-for="EstimateResult.LaborHoursAverage"
                       type="hidden" />

                <input asp-for="EstimateResult.LaborHoursHigh"
                       type="hidden" />

                <input asp-for="EstimateResult.PartsLow"
                       type="hidden" />

                <input asp-for="EstimateResult.PartsAverage"
                       type="hidden" />

                <input asp-for="EstimateResult.PartsHigh"
                       type="hidden" />

                <input asp-for="EstimateResult.ShopFeeAverage"
                       type="hidden" />

                <input asp-for="EstimateResult.SalesTaxRate"
                       type="hidden" />

                <input asp-for="EstimateResult.DiagnosticFee"
                       type="hidden" />

                <input asp-for="EstimateResult.TowFee"
                       type="hidden" />

                <input asp-for="EstimateResult.LowEstimate"
                       type="hidden" />

                <input asp-for="EstimateResult.ExpectedEstimate"
                       type="hidden" />

                <input asp-for="EstimateResult.HighEstimate"
                       type="hidden" />

                <input asp-for="EstimateResult.EstimateNote"
                       type="hidden" />

                <h2>
                    REPAIR COST ESTIMATE
                </h2>

                <p style="
                    font-size:1.1rem;
                    font-weight:900;
                    margin-bottom:24px;">

                    @if (Model.Input.VehicleYear > 0)
                    {
                        @Model.Input.VehicleYear
                        <text> </text>
                    }

                    @Model.Input.VehicleMake
                    @Model.Input.VehicleModel

                </p>

                <p>
                    <strong>
                        Repair:
                    </strong>

                    @Model.EstimateResult.RepairType
                </p>

                <p>
                    <strong>
                        Location:
                    </strong>

                    @Model.EstimateResult.LocationUsed
                </p>

                <div class="analyzer-section-divider">
                </div>

                <p>
                    <strong>
                        Low Estimate:
                    </strong>

                    @Money(
                        Model.EstimateResult.LowEstimate)
                </p>

                <p style="font-size:1.2rem;">

                    <strong>
                        Expected Estimate:
                    </strong>

                    @Money(
                        Model.EstimateResult.ExpectedEstimate)

                </p>

                <p>
                    <strong>
                        High Estimate:
                    </strong>

                    @Money(
                        Model.EstimateResult.HighEstimate)
                </p>

                <div class="analyzer-section-divider">
                </div>

                <p>
                    <strong>
                        Average Labor Rate:
                    </strong>

                    @Money(
                        Model.EstimateResult.LaborRateAverage)

                    per hour
                </p>

                <p>
                    <strong>
                        Average Labor Time:
                    </strong>

                    @Hours(
                        Model.EstimateResult.LaborHoursAverage)

                    hours
                </p>

                <p>
                    <strong>
                        Average Parts Cost:
                    </strong>

                    @Money(
                        Model.EstimateResult.PartsAverage)
                </p>

                <p>
                    <strong>
                        Average Shop Fee:
                    </strong>

                    @Money(
                        Model.EstimateResult.ShopFeeAverage)
                </p>

                @if (Model.EstimateResult.DiagnosticFee > 0)
                {
                    <p>
                        <strong>
                            Diagnostic Fee:
                        </strong>

                        @Money(
                            Model.EstimateResult.DiagnosticFee)
                    </p>
                }

                @if (Model.EstimateResult.TowFee > 0)
                {
                    <p>
                        <strong>
                            Tow Fee:
                        </strong>

                        @Money(
                            Model.EstimateResult.TowFee)
                    </p>
                }

                @if (!string.IsNullOrWhiteSpace(
                    Model.EstimateResult.EstimateNote))
                {
                    <p>
                        @Model.EstimateResult.EstimateNote
                    </p>
                }

                <div class="analyzer-section-divider">
                </div>

                <h2>
                    COMPLETE REPAIR DECISION
                </h2>

                <p>
                    PonyUp has filled Repair Cost with the
                    expected estimate. Change it only if you
                    have a more accurate quote.
                </p>

                <div class="form-row">

                    <label asp-for="Input.RepairCost">
                        Repair Cost
                    </label>

                    <input asp-for="Input.RepairCost" />

                </div>

                <div class="form-row">

                    <label asp-for="Input.Mileage">
                        Mileage
                    </label>

                    <input asp-for="Input.Mileage" />

                </div>

                <div class="form-row">

                    <label asp-for="Input.VehicleValue">
                        Estimated Vehicle Value
                    </label>

                    <input asp-for="Input.VehicleValue" />

                </div>

                <div class="form-row">

                    <label asp-for="Input.Condition">
                        Overall Vehicle Condition
                    </label>

                    <select asp-for="Input.Condition">

                        <option value="Poor">
                            Poor
                        </option>

                        <option value="Fair">
                            Fair
                        </option>

                        <option value="Good">
                            Good
                        </option>

                        <option value="Excellent">
                            Excellent
                        </option>

                    </select>

                </div>

                <div class="form-row">

                    <label asp-for="Input.OwnershipYears">
                        Years You Plan to Keep It
                    </label>

                    <input asp-for="Input.OwnershipYears" />

                </div>

                <div class="form-check-row single-check">

                    <label>

                        <input asp-for="Input.IsSafetyCritical" />

                        Safety-Critical Repair

                    </label>

                </div>

                <div class="form-actions">

                    <button class="btn-red"
                            type="submit"
                            asp-page-handler="Analyze">

                        ANALYZE REPAIR

                    </button>

                    <button class="btn-dark"
                            type="submit"
                            asp-page-handler="ChangeEstimate"
                            formnovalidate>

                        CHANGE ESTIMATE

                    </button>

                </div>

            </form>

        </div>
    }

    @*
        ==================================================
        STAGE 3
        PONYUP STOPLIGHT RESULT

        Appears ONLY after Analyze Repair succeeds.
        ==================================================
    *@

    @if (Model.WorkflowStage == 3 &&
         Model.Result != null)
    {
        <div id="repair-result-panel">

            <partial name="_PonyUpStoplightResult"
                     model="stoplight" />

            <div class="price-card featured"
                 style="max-width:900px;margin:20px auto 0;">

                <h2>
                    REPAIR DECISION DETAILS
                </h2>

                <p>
                    <strong>
                        Financial Impact:
                    </strong>

                    @Model.Result.FinancialImpact
                </p>

                @if (Model.Result.NextSteps != null &&
                     Model.Result.NextSteps.Count > 0)
                {
                    <div class="analyzer-section-divider">
                    </div>

                    <h3>
                        NEXT STEPS
                    </h3>

                    <ul>

                        @foreach (
                            string nextStep
                            in Model.Result.NextSteps)
                        {
                            <li>
                                @nextStep
                            </li>
                        }

                    </ul>
                }

            </div>

            <form method="post"
                  style="max-width:900px;margin:20px auto;">

                <input asp-for="WorkflowStage"
                       type="hidden" />

                <input asp-for="EstimateCreditConsumed"
                       type="hidden" />

                <input asp-for="Input.Vin"
                       type="hidden" />

                <input asp-for="Input.VehicleYear"
                       type="hidden" />

                <input asp-for="Input.VehicleMake"
                       type="hidden" />

                <input asp-for="Input.VehicleModel"
                       type="hidden" />

                <input asp-for="Input.RepairCost"
                       type="hidden" />

                <input asp-for="Input.Mileage"
                       type="hidden" />

                <input asp-for="Input.VehicleValue"
                       type="hidden" />

                <input asp-for="Input.Condition"
                       type="hidden" />

                <input asp-for="Input.OwnershipYears"
                       type="hidden" />

                <input asp-for="Input.IsSafetyCritical"
                       type="hidden" />

                <input asp-for="EstimateInput.City"
                       type="hidden" />

                <input asp-for="EstimateInput.State"
                       type="hidden" />

                <input asp-for="EstimateInput.ZipCode"
                       type="hidden" />

                <input asp-for="EstimateInput.RepairType"
                       type="hidden" />

                <input asp-for="EstimateInput.IncludeDiagnosticFee"
                       type="hidden" />

                <input asp-for="EstimateInput.IncludeTowFee"
                       type="hidden" />

                @if (Model.EstimateResult != null)
                {
                    <input asp-for="EstimateResult.RepairType"
                           type="hidden" />

                    <input asp-for="EstimateResult.LocationUsed"
                           type="hidden" />

                    <input asp-for="EstimateResult.LaborRateLow"
                           type="hidden" />

                    <input asp-for="EstimateResult.LaborRateAverage"
                           type="hidden" />

                    <input asp-for="EstimateResult.LaborRateHigh"
                           type="hidden" />

                    <input asp-for="EstimateResult.LaborHoursLow"
                           type="hidden" />

                    <input asp-for="EstimateResult.LaborHoursAverage"
                           type="hidden" />

                    <input asp-for="EstimateResult.LaborHoursHigh"
                           type="hidden" />

                    <input asp-for="EstimateResult.PartsLow"
                           type="hidden" />

                    <input asp-for="EstimateResult.PartsAverage"
                           type="hidden" />

                    <input asp-for="EstimateResult.PartsHigh"
                           type="hidden" />

                    <input asp-for="EstimateResult.ShopFeeAverage"
                           type="hidden" />

                    <input asp-for="EstimateResult.SalesTaxRate"
                           type="hidden" />

                    <input asp-for="EstimateResult.DiagnosticFee"
                           type="hidden" />

                    <input asp-for="EstimateResult.TowFee"
                           type="hidden" />

                    <input asp-for="EstimateResult.LowEstimate"
                           type="hidden" />

                    <input asp-for="EstimateResult.ExpectedEstimate"
                           type="hidden" />

                    <input asp-for="EstimateResult.HighEstimate"
                           type="hidden" />

                    <input asp-for="EstimateResult.EstimateNote"
                           type="hidden" />
                }

                <div class="form-actions">

                    <button type="submit"
                            class="btn-dark"
                            asp-page-handler="EditAnalysis"
                            formnovalidate>

                        EDIT ANALYSIS

                    </button>

                </div>

            </form>

        </div>
    }

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
